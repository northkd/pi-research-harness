#!/usr/bin/env bash
set -euo pipefail
umask 077
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export PI_CODING_AGENT_DIR="${PI_RESEARCH_AGENT_DIR:-$HOME/.local/share/pi-research-harness/agent}"
export PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0
export PI_BG_DOCK_SHORTCUT="${PI_BG_DOCK_SHORTCUT:-off}"
export PI_RESEARCH_LOOP_ROOT="$ROOT/extensions/research-loop"
if [[ "${1:-}" == host || "${PI_RESEARCH_BACKEND:-}" == standalone || ! -d "${PI_RESEARCH_DASHBOARD_SOURCE:-$ROOT/.runtime/dashboard-source}" ]]; then
  export PI_RESEARCH_HOST_DIR="${PI_RESEARCH_HOST_DIR:-$ROOT/.runtime/host}"
  export PI_RESEARCH_WORKBENCH_DIR="${PI_RESEARCH_WORKBENCH_DIR:-$PI_RESEARCH_HOST_DIR/res-workflow}"
  export PI_RESEARCH_HOST_MCP=1
else
  export PI_RESEARCH_BACKEND=dashboard
fi
export PATH="$ROOT/bin:$PATH"
if [[ "${1:-}" == host ]]; then
  shift
  exec node "$ROOT/extensions/research-host/cli/main.mjs" "$@"
fi
PI_BIN="${PI_RESEARCH_PI_BIN:-$ROOT/.runtime/pi/node_modules/.bin/pi}"
if [[ ! -x "$PI_BIN" ]]; then
  printf 'Pi runtime missing. Run scripts/install.sh, or set PI_RESEARCH_PI_BIN.\n' >&2
  exit 1
fi
exec "$PI_BIN" "$@"
