{
  "mcpServers": {
    "pi-dashboard": {
      "url": "http://127.0.0.1:8000/mcp"
    },
    "research-browser": {
      "command": "node",
      "args": [
        "/ABSOLUTE/PATH/pi-research-harness/.runtime/browser-mcp/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--browserUrl=http://127.0.0.1:9222",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
