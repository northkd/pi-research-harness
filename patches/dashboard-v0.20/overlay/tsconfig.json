{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@blackbelt-technology/pi-dashboard-speed-plugin": [
        "./extras/speed-plugin/src/index.tsx"
      ],
      "@blackbelt-technology/pi-dashboard-browser-plugin/science-host": [
        "./packages/browser-plugin/src/server/science-host.ts"
      ],
      "@earendil-works/pi-coding-agent": [
        "./node_modules/@earendil-works/pi-coding-agent"
      ],
      "@earendil-works/pi-ai": [
        "./node_modules/@earendil-works/pi-ai"
      ],
      "@earendil-works/pi-tui": [
        "./node_modules/@earendil-works/pi-tui"
      ],
      "@blackbelt-technology/pi-dashboard-app-kit/react": [
        "./packages/app-kit/src/react/index.ts"
      ],
      "@blackbelt-technology/pi-dashboard-app-kit": [
        "./packages/app-kit/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/dist",
    "packages/team-app"
  ]
}
