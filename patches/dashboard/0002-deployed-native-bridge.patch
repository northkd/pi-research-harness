+type Bus = {on(name: string, cb: (value: any) => void): (() => void) | void; emit(name: string, value: unknown): void};
+const UUID = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i;
+/** Internal detail address. Never accepts paths or arbitrary executor parameters. */
+export function parseNativeDetailAddress(value: unknown): {id: string; index?: number} | undefined {
+  if (typeof value !== 'string') return;
+  const match = /^native-detail:([^:]+)(?::(\d{1,2}))?$/.exec(value);
+  if (!match || !UUID.test(match[1])) return;
+  return {id: match[1], ...(match[2] === undefined ? {} : {index: Number(match[2])})};
+}
+export function nativeDetailTargets(snapshot: any): Set<string> {
+  const targets = new Set<string>(); let budget = 300;
+  function walk(nodes: any, owner?: string, depth = 0) {
+    if (!Array.isArray(nodes) || depth > 6) return;
+    for (const node of nodes.slice(0,40)) {
+      if (--budget < 0) return;
+      if (!node || typeof node !== 'object') continue;
+      const run = ['subagent','workflow'].includes(node.kind) && typeof node.id === 'string' && UUID.test(node.id) ? node.id : undefined;
+      if (run) targets.add(`native-detail:${run}`);
+      const step = node.kind === 'step' && typeof node.id === 'string' ? /^step:(\d{1,2})$/.exec(node.id) : null;
+      if (step && owner) targets.add(`native-detail:${owner}:${Number(step[1])}`);
+      walk(node.children,run ?? owner,depth+1);
+    }
+  }
+  walk(snapshot?.runs); return targets;
+}
+/** Two concurrent read-only requests; replies are current-session and request scoped. */
+export function createNativeDetailReader(bus: Bus, session: () => string | undefined,
+  publish: (data: Record<string,unknown>) => void) {
+  let owner: string | undefined; let targets = new Set<string>();
+  const pending = new Map<string,()=>void>();
+  return {
+    update(snapshot: unknown) { owner=session(); targets=nativeDetailTargets(snapshot); },
+    request(address: unknown, requestId: unknown) {
+      if (typeof address !== 'string' || !address.startsWith('native-detail:')) return false;
+      const current=session();
+      if (!current || typeof requestId !== 'string' || !UUID.test(requestId)) return true;
+      const reply = (data: Record<string,unknown>) => {if(session()===current) publish({address,requestId,__resyncRequestId:requestId,...data});};
+      const target=parseNativeDetailAddress(address);
+      if (!target || owner!==current || !targets.has(address)) {reply({ok:false,error:'该节点不在当前会话可查询快照内'});return true;}
+      if (pending.has(requestId)) return true;
+      if (pending.size>=2) {reply({ok:false,error:'详情查询繁忙，请稍后重试'});return true;}
+      const rpcId=crypto.randomUUID(); let timer: ReturnType<typeof setTimeout>;
+      const off=bus.on(`subagents:rpc:v1:reply:${rpcId}`,value=>{
+        cleanup();
+        if (value?.success!==true) {reply({ok:false,error:'执行器未能提供此节点的记录'});return;}
+        const text=typeof value.data?.text==='string'?value.data.text:'';
+        reply({ok:true,text:text.slice(0,60000),truncated:text.length>60000,receivedAt:Date.now(),scope:'执行器返回的最多 200 行记录，不保证完整历史'});
+      });
+      function cleanup(){clearTimeout(timer);if(typeof off==='function')off();pending.delete(requestId as string);}
+      timer=setTimeout(()=>{cleanup();reply({ok:false,error:'详情查询超时'});},15000);
+      pending.set(requestId,cleanup);
+      try {bus.emit('subagents:rpc:v1:request',{version:1,requestId:rpcId,method:'status',params:{...target,view:'transcript',lines:200}});} catch {cleanup();reply({ok:false,error:'详情查询发送失败'});}
+      return true;
+    },
+    dispose(){for(const cleanup of pending.values())cleanup();pending.clear();targets.clear();owner=undefined;}
+  };
+}
