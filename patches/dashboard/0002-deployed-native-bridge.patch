+/** Read-only native pi-subagents RPC observer. No spawn/control or filesystem access. */
+const REALTIME_EVENTS = [
+  'subagent:child-status',
+  'subagent:async-started',
+  'subagent:async-complete',
+  'subagent:control-event',
+  'subagent:process-terminal',
+];
+/** Coalesce bursts: a fan-out can emit many child-status lines in one tick. */
+const REALTIME_DEBOUNCE_MS = 150;
+/** Safety-net poll, kept as the floor the reference project also uses. */
+const POLL_INTERVAL_MS = 2000;
+/** Freshness marker: a snapshot older than this is shown as stale by the UI. */
+const STALE_AFTER_MS = 20000;
+export function observeNativeSubagents(events: {
+  on: (name: string, cb: (data: any) => void) => (() => void) | void;
+  emit: (name: string, data: unknown) => void;
+}, session: () => string | undefined, publish: (data: Record<string, unknown>) => void) {
+  let disposed = false;
+  let pending = false;
+  let release: (() => void) | undefined;
+  let timeout: ReturnType<typeof setTimeout> | undefined;
+  let debounce: ReturnType<typeof setTimeout> | undefined;
+  let lastSignature = '';
+  let lastPublished = 0;
+  const tick = () => {
+    const owner = session();
+    if (disposed || pending || !owner) return;
+    pending = true;
+    const requestId = crypto.randomUUID();
+    const done = () => { pending = false; release?.(); release = undefined; clearTimeout(timeout); };
+    const deliver = (data: Record<string, unknown>) => {
+      if (disposed || session() !== owner) return;
+      // Ignore timestamps when deduplicating; retain a heartbeat so the UI can
+      // distinguish "no change" from "adapter stopped answering".
+      const signature = owner + JSON.stringify(data, (key, value) => /^(generatedAt|receivedAt|updatedAt)$/.test(key) ? undefined : value);
+      if (signature === lastSignature && Date.now() - lastPublished < STALE_AFTER_MS) return;
+      lastSignature = signature;
+      lastPublished = Date.now();
+      publish({ ...data, receivedAt: lastPublished });
+    };
+    const off = events.on(`subagents:rpc:v1:reply:${requestId}`, reply => {
+      done();
+      deliver({ available: reply?.success === true,
+        snapshot: reply?.success ? reply.data?.asyncSnapshot : undefined,
+        fleet: reply?.success ? reply.data?.fleet : undefined });
+    });
+    release = typeof off === 'function' ? off : undefined;
+    timeout = setTimeout(() => { done(); deliver({ available: false }); }, 4000);
+    try { events.emit('subagents:rpc:v1:request', { version: 1, requestId, method: 'status', params: {} }); }
+    catch { done(); deliver({ available: false }); }
+  };
+  // Event-driven path: any real subagent activity schedules an immediate refresh.
+  const schedule = () => {
+    if (disposed || debounce) return;
+    debounce = setTimeout(() => { debounce = undefined; tick(); }, REALTIME_DEBOUNCE_MS);
+  };
+  const unsubscribes = REALTIME_EVENTS.map(name => {
+    try { return events.on(name, () => schedule()); }
+    catch { return undefined; }
+  });
+  const interval = setInterval(tick, POLL_INTERVAL_MS);
+  interval.unref?.();
+  tick();
+  return () => {
+    disposed = true;
+    clearInterval(interval);
+    clearTimeout(timeout);
+    if (debounce) clearTimeout(debounce);
+    release?.();
+    for (const off of unsubscribes) if (typeof off === 'function') off();
+  };
+}
