@@ -0,0 +1,112 @@
+import { describe, expect, it } from "vitest";
+import { createInitialState, reduceEvent } from "../chat/event-reducer.js";
+
+describe("event-reducer session_tree handling", () => {
+  it("① truncates message list from [u1, a1, u2, a2] to [u1, a1] when session_tree newLeafId is a1's entryId", () => {
+    const state = createInitialState();
+    state.messages = [
+      { id: "u1", entryId: "entry-u1", role: "user", content: "first user", timestamp: 1000 },
+      { id: "a1", entryId: "entry-a1", role: "assistant", content: "first assistant", timestamp: 1100 },
+      { id: "u2", entryId: "entry-u2", role: "user", content: "second user", timestamp: 1200 },
+      { id: "a2", entryId: "entry-a2", role: "assistant", content: "second assistant", timestamp: 1300 },
+    ];
+
+    const next = reduceEvent(state, {
+      eventType: "session_tree",
+      timestamp: 1400,
+      data: { newLeafId: "entry-a1", oldLeafId: "entry-a2" },
+    });
+
+    expect(next.messages.map((m) => m.id)).toEqual(["u1", "a1"]);
+    expect(next.historyGap).toBeUndefined();
+    expect(next.needsHistoryReload).toBeUndefined();
+  });
+
+  it("② clears message list when session_tree newLeafId is null (navigated to root)", () => {
+    const state = createInitialState();
+    state.messages = [
+      { id: "u1", entryId: "entry-u1", role: "user", content: "first user", timestamp: 1000 },
+      { id: "a1", entryId: "entry-a1", role: "assistant", content: "first assistant", timestamp: 1100 },
+    ];
+
+    const next = reduceEvent(state, {
+      eventType: "session_tree",
+      timestamp: 1200,
+      data: { newLeafId: null, oldLeafId: "entry-a1" },
+    });
+
+    expect(next.messages).toEqual([]);
+    expect(next.historyGap).toBeUndefined();
+    expect(next.needsHistoryReload).toBeUndefined();
+  });
+
+  it("③ preserves list and enters gap/reload path when session_tree newLeafId is not in the list", () => {
+    const state = createInitialState();
+    state.messages = [
+      { id: "u1", entryId: "entry-u1", role: "user", content: "first user", timestamp: 1000 },
+      { id: "a1", entryId: "entry-a1", role: "assistant", content: "first assistant", timestamp: 1100 },
+    ];
+
+    const next = reduceEvent(state, {
+      eventType: "session_tree",
+      timestamp: 1200,
+      data: { newLeafId: "missing-entry-id", oldLeafId: "entry-a1" },
+    });
+
+    // List is preserved intact (not guessing or destroying)
+    expect(next.messages.map((m) => m.id)).toEqual(["u1", "a1"]);
+    // Enters history gap / reload path
+    expect(next.historyGap).toBe(true);
+    expect(next.needsHistoryReload).toBe(true);
+  });
+
+  it("clears undoPending and requests reload when newLeafId is absent from messages", () => {
+    const state = createInitialState();
+    state.messages = [
+      { id: "u1", entryId: "entry-u1", role: "user", content: "u1", timestamp: 1000 },
+      { id: "a1", entryId: "entry-a1", role: "assistant", content: "a1", timestamp: 1100 },
+      { id: "u2", entryId: "entry-u2", role: "user", content: "u2", timestamp: 1200 },
+    ];
+    state.undoPending = {
+      messageId: "u2",
+      entryId: "entry-u2",
+      requestedAt: Date.now(),
+    };
+
+    // The leaf is missing locally, independent of the pending target's parent.
+    const next = reduceEvent(state, {
+      eventType: "session_tree",
+      timestamp: 1300,
+      data: { newLeafId: "entry-other" },
+    });
+
+    expect(next.historyGap).toBe(true);
+    expect(next.needsHistoryReload).toBe(true);
+    expect(next.undoPending).toBeUndefined();
+  });
+
+  it("truncates across a synthetic separator without inferring a parent from adjacent UI rows", () => {
+    const state = createInitialState();
+    state.messages = [
+      { id: "u1", entryId: "entry-u1", role: "user", content: "u1", timestamp: 1000 },
+      { id: "a1", entryId: "entry-a1", role: "assistant", content: "a1", timestamp: 1100 },
+      { id: "sep-2", role: "turnSeparator", content: "", timestamp: 1150 },
+      { id: "u2", entryId: "entry-u2", parentId: "entry-a1", role: "user", content: "u2", timestamp: 1200 },
+    ];
+    state.undoPending = {
+      messageId: "u2",
+      entryId: "entry-u2",
+      requestedAt: Date.now(),
+    };
+
+    const next = reduceEvent(state, {
+      eventType: "session_tree",
+      timestamp: 1300,
+      data: { newLeafId: "entry-a1" },
+    });
+
+    expect(next.messages.map((m) => m.id)).toEqual(["u1", "a1"]);
+    expect(next.undoPending).toBeUndefined();
+    expect(next.historyGap).toBeUndefined();
+  });
+});
