+++ b/packages/server/src/__tests__/browser-gateway.branch-replay.test.ts
@@ -0,0 +1,382 @@
+import { EventEmitter } from "node:events";
+import { mkdtempSync, writeFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { ServerToBrowserMessage } from "@blackbelt-technology/pi-dashboard-shared/browser-protocol.js";
+import type { DashboardEvent } from "@blackbelt-technology/pi-dashboard-shared/types.js";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { WebSocket } from "ws";
+import { createPiGateway } from "../pi/pi-gateway.js";
+import { peekGapState } from "../browser-handlers/subscription-handler.js";
+import { wireEvents } from "../event-wiring.js";
+import { createDirectoryService } from "../directory-service.js";
+import { createBrowserGateway } from "../pairing/browser-gateway.js";
+import { createMemoryEventStore } from "../persistence/memory-event-store.js";
+import { createMemorySessionManager } from "../session/memory-session-manager.js";
+const { replayActiveBranch, acknowledgeBranchReplay } = await import(`${process.cwd()}/packages/extension/src/session-sync.ts`);
+
+class Socket extends EventEmitter {
+  OPEN = 1; readyState = 1; bufferedAmount = 0;
+  frames: ServerToBrowserMessage[] = [];
+  onSend?: (message: ServerToBrowserMessage) => void;
+  send(data: string) {
+    const message = JSON.parse(data) as ServerToBrowserMessage;
+    this.frames.push(message);
+    this.onSend?.(message);
+  }
+  request(message: unknown) { this.emit("message", JSON.stringify(message)); }
+}
+const settle = () => new Promise((resolve) => setTimeout(resolve, 30));
+const events = (prefix: string, count: number): DashboardEvent[] => Array.from({ length: count }, (_, i) => ({
+  eventType: i % 2 ? "message_end" : "message_start", timestamp: i + 1,
+  data: { entryId: `${prefix}-${i}`, message: { role: i % 2 ? "assistant" : "user", content: `${prefix}-${i}` } },
+}));
+const replayIds = (socket: Socket) => socket.frames.flatMap((message) => message.type === "event_replay" ? message.events.map(({ event }) => event.data.entryId) : []);
+const teardown: Array<() => void> = [];
+afterEach(() => { for (const close of teardown.splice(0)) close(); });
+
+function rig(options: { directoryService?: any; disk?: boolean; limit?: number; mode?: "head-tail" | "tail-only"; realPi?: boolean } = {}) {
+  const sessionManager = createMemorySessionManager();
+  const eventStore = createMemoryEventStore(() => false);
+  let directoryService = options.directoryService;
+  if (options.disk) {
+    const dir = mkdtempSync(join(tmpdir(), "branch-authority-"));
+    const file = join(dir, "session.jsonl");
+    writeFileSync(file, [
+      { type: "session", id: "s1", cwd: dir, timestamp: "2026-01-01T00:00:00Z" },
+      { type: "message", id: "disk-u", parentId: null, timestamp: "2026-01-01T00:00:01Z", message: { role: "user", content: "disk history" } },
+    ].map((record) => JSON.stringify(record)).join("\n") + "\n");
+    sessionManager.register({ id: "s1", cwd: dir, source: "tui", sessionFile: file });
+    directoryService = createDirectoryService({ getPinnedDirectories: () => [] } as any, sessionManager, undefined, { useLoadWorker: false });
+    teardown.push(() => { directoryService.stopPolling(); rmSync(dir, { recursive: true, force: true }); });
+  }
+  const piGateway: any = options.realPi
+    ? createPiGateway(sessionManager, { pingInterval: 0 })
+    : { sendToSession: vi.fn(), isConnected: () => true };
+  if (options.realPi) teardown.push(() => piGateway.stop());
+  const browserGateway = createBrowserGateway(sessionManager, eventStore, piGateway,
+    undefined, undefined, undefined, undefined, directoryService,
+    undefined, undefined, undefined, undefined, undefined, undefined, undefined,
+    undefined, undefined, undefined, options.limit ?? 0, options.mode ?? "head-tail");
+  wireEvents({ sessionManager, eventStore, piGateway, browserGateway,
+    sessionOrderManager: { insert: vi.fn(), moveToFront: vi.fn(), getOrder: () => [] } as any,
+    preferencesStore: { getPinnedDirectories: () => [] } as any,
+    pendingForkRegistry: {} as any, directoryService: {} as any,
+    knownSessionIds: new Set(), pendingDashboardSpawns: new Map(),
+  });
+  if (!options.disk) sessionManager.register({ id: "s1", cwd: "/fixture", source: "tui" });
+  sessionManager.register({ id: "s2", cwd: "/other", source: "tui" });
+  const sockets: Socket[] = [];
+  function connect() {
+    const socket = new Socket(); sockets.push(socket);
+    browserGateway.wss.emit("connection", socket as any, undefined);
+    socket.frames.length = 0;
+    return socket;
+  }
+  teardown.push(() => {
+    for (const socket of sockets) { socket.readyState = 3; socket.emit("close"); }
+    browserGateway.wss.close();
+  });
+  function seed(prefix = "old", count = 320, sessionId = "s1") {
+    for (const event of events(prefix, count)) eventStore.insertEvent(sessionId, event);
+  }
+  function replace(prefix = "fresh", count = 2) {
+    piGateway.onEvent("s1", { type: "session_branch_replay", sessionId: "s1", entryCount: count, events: events(prefix, count) });
+  }
+  function subscribe(socket: Socket, sessionId = "s1") { socket.request({ type: "subscribe", sessionId, lastSeq: 0 }); }
+  return { sessionManager, eventStore, piGateway, browserGateway, connect, seed, replace, subscribe };
+}
+
+function pendingDirectory() {
+  let complete!: (result: any) => void;
+  let reject!: (error: unknown) => void;
+  let loading = false;
+  const directoryService: any = {
+    loadSessionEvents: vi.fn(() => {
+      if (loading) return Promise.resolve({ success: false, events: [], error: "already_loading" });
+      loading = true;
+      return new Promise((resolve, fail) => { complete = resolve; reject = fail; }).finally(() => { loading = false; });
+    }),
+    cancelLoad: vi.fn(), knownDirectories: () => [], folderHeadSnapshot: () => [],
+  };
+  return { directoryService, complete: (result: any) => complete(result), reject: (error: unknown) => reject(error) };
+}
+
+describe("BrowserGateway branch replay generations (real handlers and store)", () => {
+  it("W2 chunks stay private until complete commit; partial, wrong-order and superseded transactions retain old history", async () => {
+    const r = rig(); r.seed("old", 2); const socket = r.connect(); r.subscribe(socket); await settle();
