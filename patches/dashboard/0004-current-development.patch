diff --git a/packages/server/src/__tests__/goal-snapshot-sync.test.ts b/packages/server/src/__tests__/goal-snapshot-sync.test.ts
new file mode 100644
index 00000000..6c9de86a
--- /dev/null
+++ b/packages/server/src/__tests__/goal-snapshot-sync.test.ts
@@ -0,0 +1,159 @@
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createGoalSnapshotSync } from "../goal/goal-snapshot-sync.js";
+import { createGoalStatusProjector } from "../goal/goal-status-projector.js";
+import { createGoalStore, type GoalStore } from "../goal/goal-store.js";
+
+describe("read-only goal snapshot synchronization", () => {
+  let dir: string;
+  let file: string;
+  let store: GoalStore;
+  let id: string;
+  const cwd = "/repo/goal";
+  const sid = "driver-1";
+  const session = () => ({ id: sid, cwd, goalId: id, sessionFile: file, status: "active" as const });
+  const header = (sessionId = sid) => ({ type: "session", id: sessionId });
+  const state = (status = "active", turnsUsed = 0, over = {}) => ({
+    type: "custom", id: "state-1", parentId: null, customType: "pi-goal-hermes:state",
+    data: { goal: { id: "hermes-goal", goal: "Deliver evidence", status, turnsUsed, maxTurns: 20,
+      lastVerdict: null, lastReason: null, pausedReason: status === "paused" ? "user pause" : null,
+      updatedAt: Date.now() + 1000, ...over } },
+  });
+  const write = async (entries: unknown[], tail = "") => fs.writeFile(file, entries.map((e) => JSON.stringify(e)).join("\n") + "\n" + tail);
+  const cur = async () => (await store.list(cwd))[0]!;
+  const sync = (over = {}) => createGoalSnapshotSync({ store, listSessions: () => [session()], ...over });
+
+  beforeEach(async () => {
+    dir = await fs.mkdtemp(path.join(os.tmpdir(), "goal-snapshot-sync-"));
+    file = path.join(dir, "session.jsonl");
+    store = createGoalStore({ dataDir: path.join(dir, "goals"), debounceMs: 1 });
+    const g = await store.create(cwd, { objective: "Deliver evidence" }); id = g.id;
+    await store.linkSession(cwd, id, sid);
+    await store.setStatus(cwd, id, "paused", "session ended");
+  });
+  afterEach(async () => { store.dispose(); vi.restoreAllMocks(); await fs.rm(dir, { recursive: true, force: true }); });
+
+  it("recovers the missed idle goal-set at active/zero without a command or model call", async () => {
+    await write([header(), state()]);
+    const s = sync(); await s.poll();
+    expect(await cur()).toMatchObject({ status: "pursuing", lastKnownTurnsUsed: 0, totalTurnsUsed: 0 });
+    expect((await cur()).statusReason).toBeUndefined();
+    const updatedAt = (await cur()).updatedAt;
+    await s.poll();
+    expect((await cur()).updatedAt).toBe(updatedAt);
+    await s.stop();
+  });
+
+  it("follows the current branch, tolerates malformed/partial lines, and picks up idle pauses", async () => {
+    const root = { type: "message", id: "root", parentId: null };
+    await write([header(), root, { ...state("done", 9), id: "other", parentId: "root" }, { ...state(), id: "current", parentId: "root" }], '{"type":');
+    const s = sync(); await s.poll();
+    expect(await cur()).toMatchObject({ status: "pursuing", lastKnownTurnsUsed: 0 });
+    await write([header(), root, { ...state("done", 9), id: "other", parentId: "root" }, { ...state("paused", 0), id: "current", parentId: "root" }]);
+    await s.poll();
+    expect(await cur()).toMatchObject({ status: "paused", statusReason: "user pause", totalTurnsUsed: 0 });
+    await s.stop();
+  });
+
+  it("rejects a header for another session and refuses a remote-origin file", async () => {
+    await write([header("other-session"), state()]);
+    const s = sync(); await s.poll();
+    expect((await cur()).status).toBe("paused");
+    await write([header(), state()]);
+    const remote = sync({ listSessions: () => [{ ...session(), originDeviceId: "remote-device" }] });
+    await remote.poll();
+    expect((await cur()).status).toBe("paused");
+    await s.stop(); await remote.stop();
+  });
+
+  it("cannot replace a newer manual pause with an old active snapshot", async () => {
+    await write([header(), state("active", 3, { updatedAt: 1 })]);
+    await store.finalize(cwd, id, { status: "paused", statusReason: "paused by user" });
+    const s = sync(); await s.poll();
+    expect(await cur()).toMatchObject({ status: "paused", statusReason: "paused by user" });
+    expect((await cur()).totalTurnsUsed).toBeUndefined();
+    await s.stop();
+  });
+
+  it("ignores a former driver, including when the driver changes during the read", async () => {
+    await write([header(), state("done", 4)]);
+    const apply = store.applyStatus;
+    vi.spyOn(store, "applyStatus").mockImplementation(async (...args) => {
+      await store.replaceDriver(cwd, id, "new-driver");
+      return apply(...args);
+    });
+    const s = sync(); await s.poll();
+    expect(await cur()).toMatchObject({ status: "paused", driverSessionId: "new-driver" });
+    await s.stop();
+  });
+
+  it("does not count recovered turns again when a live event arrives or the projector restarts", async () => {
+    await write([header(), state("active", 3)]);
+    const s = sync(); await s.poll();
+    const deps = { store, lookupSession: () => ({ goalId: id, cwd }) };
+    const payload = { status: "active", turnsUsed: 3 };
+    s.handleLiveStatus({ sessionId: sid, payload }, createGoalStatusProjector(deps).handle);
+    await s.poll();
+    store.dispose();
+    store = createGoalStore({ dataDir: path.join(dir, "goals"), debounceMs: 1 });
+    const afterRestart = sync();
+    afterRestart.handleLiveStatus({ sessionId: sid, payload }, createGoalStatusProjector(deps).handle);
+    await afterRestart.poll();
+    expect((await cur()).totalTurnsUsed).toBe(3);
+    await s.stop(); await afterRestart.stop();
+  });
+
+  it("preserves cumulative turns across a same-engine resume counter reset", async () => {
+    const at = Date.now() + 1000;
+    await write([header(), state("paused", 10, { updatedAt: at })]);
+    const s = sync(); await s.poll();
+    expect((await cur()).totalTurnsUsed).toBe(10);
+    await write([header(), state("active", 0, { updatedAt: at + 1 })]); await s.poll();
+    await write([header(), state("active", 3, { updatedAt: at + 2 })]); await s.poll();
+    expect(await cur()).toMatchObject({ totalTurnsUsed: 13, lastKnownTurnsUsed: 3 });
+    await s.stop();
+  });
+
+  it("does not count an inherited engine counter again after driver replacement", async () => {
+    const at = Date.now() + 1000;
+    await write([header(), state("active", 3, { updatedAt: at })]);
+    const s = sync(); await s.poll();
+    await store.replaceDriver(cwd, id, "driver-2");
+    await write([header("driver-2"), state("active", 3, { updatedAt: at + 1 })]);
+    const replacement = sync({ listSessions: () => [{ ...session(), id: "driver-2" }] });
+    await replacement.poll();
+    expect((await cur()).totalTurnsUsed).toBe(3);
+    await write([header("driver-2"), state("active", 2, { id: "new-engine-goal", updatedAt: at + 2 })]);
+    await replacement.poll();
+    expect((await cur()).totalTurnsUsed).toBe(5);
+    await s.stop(); await replacement.stop();
+  });
+
+  it("late live events and older paused state cannot overwrite an explicit dashboard pause", async () => {
+    const at = Date.now() + 1000;
+    await write([header(), state("active", 3, { updatedAt: at })]);
+    const s = sync(); await s.poll();
+    vi.spyOn(Date, "now").mockReturnValue(at + 100);
+    await store.finalize(cwd, id, { status: "paused", statusReason: "paused by user" });
+    const fallback = vi.fn();
+    s.handleLiveStatus({ sessionId: sid, payload: { status: "active", turnsUsed: 9 } }, fallback);
+    await s.poll();
+    expect(fallback).not.toHaveBeenCalled();
+    await write([header(), state("paused", 2, { updatedAt: at - 1, pausedReason: "old error" })]);
+    await s.poll();
+    expect(await cur()).toMatchObject({ status: "paused", statusReason: "paused by user", lastKnownTurnsUsed: 3, totalTurnsUsed: 3 });
+    await s.stop();
+  });
+
+  it("does not send an ended local driver's late event through the legacy projector", async () => {
+    const s = sync({ listSessions: () => [{ ...session(), status: "ended" }] });
+    const fallback = vi.fn();
+    s.handleLiveStatus({ sessionId: sid, payload: { status: "active", turnsUsed: 9 } }, fallback);
+    await s.poll();
+    expect(fallback).not.toHaveBeenCalled();
+    expect((await cur()).status).toBe("paused");
+    await s.stop();
+  });
+});
