+import { describe, it, expect, vi, afterEach } from 'vitest';
+import { observeNativeSubagents } from '../native-subagent-observer.js';
+afterEach(() => vi.useRealTimers());
+function harness() {
+  vi.useFakeTimers();
+  const handlers = new Map<string, (data: any) => void>();
+  const requests: any[] = [];
+  const events = { on: (name: string, cb: (data: any) => void) => { handlers.set(name, cb); return () => { handlers.delete(name); }; }, emit: (_name: string, data: any) => requests.push(data) };
+  let owner: string | undefined = 'session-a';
+  const publish = vi.fn();
+  const stop = observeNativeSubagents(events, () => owner, publish);
+  const reply = (data: any) => handlers.get(`subagents:rpc:v1:reply:${requests.at(-1).requestId}`)?.({success: true, data});
+  return { requests, publish, stop, reply, handlers, setOwner: (next: string | undefined) => { owner = next; } };
+}
+describe('native observer safety', () => {
+  it('only requests status and drops replies after session changes', () => {
+    // Reply before the 4s timeout so this checks ownership, not timeout output.
+    const h = harness(); vi.advanceTimersByTime(1000);
+    expect(h.requests[0].method).toBe('status');
+    h.setOwner('session-b'); h.reply({asyncSnapshot: {runs: []}});
+    expect(h.publish).not.toHaveBeenCalled(); h.stop();
+    expect(h.handlers.size).toBe(0);
+  });
+  it('deduplicates unchanged snapshots and disposes timers', () => {
+    const h = harness(); vi.advanceTimersByTime(5000); h.reply({asyncSnapshot: {runs: [], generatedAt: 1}});
+    vi.advanceTimersByTime(5000); h.reply({asyncSnapshot: {runs: [], generatedAt: 2}});
+    expect(h.publish).toHaveBeenCalledTimes(1); h.stop();
+    vi.advanceTimersByTime(100000); expect(h.requests).toHaveLength(2);
+  });
+  it('reports timeout without crashing', () => {
+    const h = harness(); vi.advanceTimersByTime(9000);
+    expect(h.publish).toHaveBeenCalledWith(expect.objectContaining({available: false})); h.stop();
+  });
+});
