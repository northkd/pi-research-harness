@@ -0,0 +1,147 @@
+import type { DashboardSession } from "@blackbelt-technology/pi-dashboard-shared/types.js";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { useMobile } from "../../hooks/useMobile.js";
+import { createInitialState } from "../../lib/chat/event-reducer.js";
+import {
+  makeRunConfig,
+  RunConfigHarness,
+} from "../../test-support/runConfigHarness.js";
+import { SessionCard } from "../session/SessionCard.js";
+import { SessionHeader } from "../session/SessionHeader.js";
+
+vi.mock("../../hooks/useMobile.js", () => ({ useMobile: vi.fn(() => false) }));
+vi.mock("@blackbelt-technology/pi-dashboard-speed-plugin", () => ({
+  SessionBillingCost: () => <span>¥0.49</span>,
+}));
+
+beforeEach(() => {
+  vi.mocked(useMobile).mockReturnValue(false);
+  localStorage.clear();
+});
+afterEach(cleanup);
+
+function session(
+  status: DashboardSession["status"] = "ended",
+): DashboardSession {
+  return {
+    id: "history-session",
+    name: "Original name",
+    status,
+    source: "tui",
+    cwd: "/tmp/project",
+    startedAt: Date.now() - 60_000,
+  };
+}
+
+const cardProps = {
+  showGitInfo: false,
+  isHidden: false,
+  onHide: () => {},
+  onUnhide: () => {},
+};
+
+describe("session rename availability", () => {
+  it.each([
+    "idle",
+    "ended",
+  ] as const)("renames a %s session from its desktop card without selecting or resuming it", (status) => {
+    const onRename = vi.fn();
+    const onSelect = vi.fn();
+    render(
+      <SessionCard
+        {...cardProps}
+        session={session(status)}
+        now={Date.now()}
+        onSelect={onSelect}
+        onRename={onRename}
+      />,
+    );
+
+    fireEvent.click(screen.getByTitle("Rename session"));
+    const input = screen.getByRole("textbox");
+    expect(document.activeElement).toBe(input);
+    fireEvent.change(input, { target: { value: "  Renamed history  " } });
+    fireEvent.keyDown(input, { key: "Enter" });
+
+    expect(onRename).toHaveBeenCalledExactlyOnceWith("Renamed history");
+    expect(onSelect).not.toHaveBeenCalled();
+    expect(screen.queryByRole("textbox")).toBeNull();
+  });
+
+  it.each([
+    false,
+    true,
+  ])("renames ended history from the header (mobile: %s), with Escape cancelling", (mobile) => {
+    vi.mocked(useMobile).mockReturnValue(mobile);
+    const onRename = vi.fn();
+    render(
+      <RunConfigHarness value={makeRunConfig()}>
+        <SessionHeader
+          session={session()}
+          state={createInitialState()}
+          onRename={onRename}
+          mobileActions={{}}
+        />
+      </RunConfigHarness>,
+    );
+
+    function startRename() {
+      if (mobile) {
+        fireEvent.click(screen.getByTestId("mobile-kebab-btn"));
+        fireEvent.click(screen.getByRole("button", { name: "Rename" }));
+        expect(screen.queryByTestId("mobile-action-menu")).toBeNull();
+      } else {
+        fireEvent.click(screen.getByTitle("Rename session"));
+      }
+      return screen.getByRole("textbox");
+    }
+
+    let input = startRename();
+    fireEvent.change(input, { target: { value: "Discard this" } });
+    fireEvent.keyDown(input, { key: "Escape" });
+    expect(onRename).not.toHaveBeenCalled();
+    expect(screen.getByText("Original name")).toBeTruthy();
+
+    input = startRename();
+    fireEvent.change(input, { target: { value: "  New history name  " } });
+    fireEvent.keyDown(input, { key: "Enter" });
+    expect(onRename).toHaveBeenCalledExactlyOnceWith(
+      "history-session",
+      "New history name",
+    );
+  });
+
+  it("omits the card editor when no rename callback is available", () => {
+    render(
+      <SessionCard
+        {...cardProps}
+        session={session()}
+        now={Date.now()}
+        onSelect={vi.fn()}
+      />,
+    );
+    expect(screen.queryByTitle("Rename session")).toBeNull();
+    fireEvent.doubleClick(screen.getByText("Original name"));
+    expect(screen.queryByRole("textbox")).toBeNull();
+  });
+
+  it.each([
+    false,
+    true,
+  ])("omits the header rename action without a callback (mobile: %s)", (mobile) => {
+    vi.mocked(useMobile).mockReturnValue(mobile);
+    render(
+      <RunConfigHarness value={makeRunConfig()}>
+        <SessionHeader
+          session={session()}
+          state={createInitialState()}
+          mobileActions={{}}
+        />
+      </RunConfigHarness>,
+    );
+    if (mobile) fireEvent.click(screen.getByTestId("mobile-kebab-btn"));
+    expect(screen.queryByTitle("Rename session")).toBeNull();
+    expect(screen.queryByRole("button", { name: "Rename" })).toBeNull();
+  });
+});
