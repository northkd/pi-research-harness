--- /dev/null
+++ b/packages/server/src/__tests__/memory-event-store.history-replacement.test.ts
@@ -0,0 +1,69 @@
+import type { DashboardEvent } from "@blackbelt-technology/pi-dashboard-shared/types.js";
+import { describe, expect, it } from "vitest";
+import { createMemoryEventStore } from "../persistence/memory-event-store.js";
+const event = (i: number): DashboardEvent => ({ eventType: i % 2 ? "message_end" : "message_start", timestamp: i,
+  data: { entryId: `e-${i}`, message: { role: i % 2 ? "assistant" : "user", content: "x".repeat(5000) } } });
+
+describe("memory-event-store authoritative history and configured replacement", () => {
+  it("empty availability follows buffer eviction/delete without changing hasEvents", () => {
+    const store = createMemoryEventStore(() => false, 1);
+    store.markHistoryAvailable("empty");
+    expect(store.hasHistory("empty")).toBe(true); expect(store.hasEvents("empty")).toBe(false);
+    store.insertEvent("other", event(1)); expect(store.hasHistory("empty")).toBe(false);
+    store.markHistoryAvailable("empty"); store.deleteEventsForSession("empty"); expect(store.hasHistory("empty")).toBe(false);
+  });
+  it.each([[3, 23, 500], [0, 0, 0]])("stage uses exact retention caps %s/%s/%s, keeps old cache/counters until single commit", (eventsCap, stringCap, dataCap) => {
+    const store = createMemoryEventStore(() => false, 2, eventsCap, stringCap, dataCap);
+    const reference = createMemoryEventStore(() => false, 2, eventsCap, stringCap, dataCap);
+    store.insertEvent("s", event(100)); const old = store.getEvents("s", 1); const before = store.getTrimStats();
+    const stage = store.createHistoryReplacement("s");
+    for (let i = 0; i < 12; i++) { stage.insertEvent(event(i)); reference.insertEvent("s", event(i)); }
+    expect(store.getEvents("s", 1)).toEqual(old); expect(store.getTrimStats()).toEqual(before);
+    expect(store.commitHistoryReplacement("wrong", stage)).toBe(false);
+    expect(createMemoryEventStore(() => false).commitHistoryReplacement("s", stage)).toBe(false);
+    expect(store.commitHistoryReplacement("s", stage)).toBe(true);
+    expect(store.getEvents("s", 1)).toEqual(reference.getEvents("s", 1));
+    expect(store.getMaxSeq("s")).toBe(reference.getMaxSeq("s"));
+    expect(store.getTrimStats().trimmedEvents.bySession).toEqual(reference.getTrimStats().trimmedEvents.bySession);
+    expect(store.getTrimStats().trimmedEvents.total).toBe(before.trimmedEvents.total + reference.getTrimStats().trimmedEvents.total);
+    expect(store.insertEvent("s", event(20))).toBe(reference.insertEvent("s", event(20)));
+    expect(store.commitHistoryReplacement("s", stage)).toBe(false);
+    expect(() => stage.insertEvent(event(21))).toThrow("Replacement is closed");
+  });
+  it("collapse indexes, retained seq gaps and telemetry transfer once", () => {
+    const store=createMemoryEventStore(()=>false,2,4,80,2000);const reference=createMemoryEventStore(()=>false,2,4,80,2000);
+    const stage=store.createHistoryReplacement("s");
+    for(let i=0;i<12;i++){
+      const e:DashboardEvent={eventType:"tool_execution_update",timestamp:i,data:{toolCallId:"t",partialResult:{details:{agentId:"a",status:"running",turn:i}}}};
+      stage.insertEvent(e);reference.insertEvent("s",e);
+    }
+    expect(store.getTrimStats().collapsedUpdates).toBe(0);
+    expect(store.commitHistoryReplacement("s",stage)).toBe(true);
