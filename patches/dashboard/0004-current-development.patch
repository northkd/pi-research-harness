+import { clearSessionEvents, PluginContextProvider, publishSessionEvent } from "@blackbelt-technology/dashboard-plugin-runtime";
+import type { ServerToBrowserMessage } from "@blackbelt-technology/pi-dashboard-shared/browser-protocol.js";
+import type { GoalRecord } from "@blackbelt-technology/pi-dashboard-shared/types.js";
+import { act, cleanup, render, waitFor } from "@testing-library/react";
+import React from "react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { Router } from "wouter";
+import { GoalDetailClaim } from "../client/GoalDetailClaim.js";
+import { GoalsBoardClaim } from "../client/GoalsBoardClaim.js";
+import { encodeFolderPath } from "../client/goals-api.js";
+
+const cwd = "/repo/live-goals";
+const goal: GoalRecord = { id: "g1", cwd, objective: "Deliver evidence", criteria: [], status: "paused", sessionIds: ["d1"], driverSessionId: "d1", createdAt: 1, updatedAt: 1, lastKnownTurnsUsed: 0, budget: { maxTurns: 20 } };
+
+afterEach(() => { cleanup(); clearSessionEvents("d1"); vi.unstubAllGlobals(); });
+
+describe("goal page live updates", () => {
+  for (const page of ["board", "standalone detail"] as const) {
+    it(`${page}: a push changes status and turns without refresh or a selected chat`, async () => {
+      vi.stubGlobal("fetch", vi.fn(async () => ({ ok: true, json: async () => ({ success: true, data: [goal] }) })));
+      publishSessionEvent("d1", { eventType: "goal_status", timestamp: 1, data: { status: "paused", goal: goal.objective, turnsUsed: 0, maxTurns: 20, lastVerdict: null, lastReason: "reload" } });
+      const listeners = new Set<(message: ServerToBrowserMessage) => void>();
+      const onMessage = (h: (message: ServerToBrowserMessage) => void) => { listeners.add(h); return () => { listeners.delete(h); }; };
+      const view = render(<Router><PluginContextProvider onMessage={onMessage}>
+        {page === "board"
+          ? <GoalsBoardClaim params={{ encodedCwd: encodeFolderPath(cwd) }} onBack={() => {}} />
+          : <GoalDetailClaim params={{ encodedCwd: encodeFolderPath(cwd), goalId: goal.id }} onBack={() => {}} />}
+      </PluginContextProvider></Router>);
+      const cardId = page === "board" ? "goal-card" : "goal-definition";
+      await waitFor(() => expect(view.getByTestId(cardId).textContent).toContain("Paused"));
+      act(() => { for (const h of listeners) h({ type: "goals_update", cwd, goals: [{ ...goal, status: "achieved", lastKnownTurnsUsed: 1 }] }); });
+      expect(view.getByTestId(cardId).textContent).toContain("Achieved");
+      const progress = view.getByTestId(page === "board" ? "goal-live-progress" : "goal-gauge-turns");
+      expect(progress.textContent).toContain("1/20");
+      if (page === "board") expect(progress.textContent).not.toContain("⏸");
+    });
+  }
+});
diff --git a/packages/goal-plugin/src/__tests__/resume-budget.test.ts b/packages/goal-plugin/src/__tests__/resume-budget.test.ts
new file mode 100644
index 00000000..a7b00d17
--- /dev/null
+++ b/packages/goal-plugin/src/__tests__/resume-budget.test.ts
@@ -0,0 +1,32 @@
+import {describe,expect,it,vi} from "vitest";
+import {registerPlugin} from "../server/index.js";
+
+async function harness(prepare: (sid:string)=>Promise<boolean>) {
+  let action:(msg:unknown)=>void=()=>{};
+  const send=vi.fn(),broadcast=vi.fn();
+  await registerPlugin({logger:{info:vi.fn(),warn:vi.fn()},broadcastToSubscribers:broadcast,registerPiHandler:vi.fn(),
+    registerBrowserHandler:(_type:string,handler:typeof action)=>{action=handler;},sendToSession:send,consume:()=>prepare} as any);
+  return {send,broadcast,act:(name:string)=>action({type:"plugin_action",pluginId:"goal",sessionId:"s",action:name})};
+}
+describe("Resume budget preparation",()=>{
+  it("dispatches Resume only after acknowledged preparation",async()=>{
+    let resolve!:(ok:boolean)=>void;
+    const h=await harness(()=>new Promise<boolean>(r=>{resolve=r;}));
+    h.act("resume"); expect(h.send).not.toHaveBeenCalled();
+    resolve(true); await vi.waitFor(()=>expect(h.send).toHaveBeenCalledWith("s","/goal resume"));
+  });
+  it("shows refusal and sends no Resume after failed preparation",async()=>{
+    const h=await harness(async()=>false); h.act("resume");
+    await vi.waitFor(()=>expect(h.broadcast).toHaveBeenCalled()); expect(h.send).not.toHaveBeenCalled();
+  });
+  it.each(["pause","done","clear"])("a later %s invalidates an in-flight Resume",async(later)=>{
+    let resolve!:(ok:boolean)=>void;
+    const h=await harness(()=>new Promise<boolean>(r=>{resolve=r;}));
+    h.act("resume"); h.act(later); resolve(true); await Promise.resolve(); await Promise.resolve();
+    expect(h.send.mock.calls).toEqual([["s",`/goal ${later}`]]);
+  });
+  it("catches preparation errors without issuing work",async()=>{
+    const h=await harness(async()=>{throw Error("test read error");}); h.act("resume");
+    await Promise.resolve(); await Promise.resolve(); expect(h.send).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/goal-plugin/src/__tests__/useGoals.test.tsx b/packages/goal-plugin/src/__tests__/useGoals.test.tsx
new file mode 100644
index 00000000..aafe1b53
--- /dev/null
+++ b/packages/goal-plugin/src/__tests__/useGoals.test.tsx
@@ -0,0 +1,115 @@
+import { PluginContextProvider } from "@blackbelt-technology/dashboard-plugin-runtime";
+import type { ServerToBrowserMessage } from "@blackbelt-technology/pi-dashboard-shared/browser-protocol.js";
+import type { GoalRecord } from "@blackbelt-technology/pi-dashboard-shared/types.js";
+import { act, cleanup, renderHook, waitFor } from "@testing-library/react";
+import React from "react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { useGoals } from "../client/useGoals.js";
+
+const cwd = "/repo/goals";
+const goal = (status: GoalRecord["status"]): GoalRecord => ({
+  id: "g1", cwd, objective: "Deliver evidence", criteria: [], sessionIds: ["s1"],
+  driverSessionId: "s1", status, createdAt: 1, updatedAt: 1,
+});
+const response = (goals: GoalRecord[]) => ({ ok: true, json: async () => ({ success: true, data: goals }) }) as Response;
+
+function harness(initialStatus: "connected" | "disconnected" = "connected") {
+  const listeners = new Set<(message: ServerToBrowserMessage) => void>();
+  const onMessage = (handler: (message: ServerToBrowserMessage) => void) => {
+    listeners.add(handler);
+    return () => { listeners.delete(handler); };
+  };
+  let connectionStatus = initialStatus;
+  function Wrapper({ children }: { children: React.ReactNode }) {
+    return <PluginContextProvider onMessage={onMessage} connectionStatus={connectionStatus}>{children}</PluginContextProvider>;
+  }
+  return {
+    Wrapper, listeners,
+    connect: () => { connectionStatus = "connected"; },
+    push: (message: ServerToBrowserMessage) => act(() => { for (const h of listeners) h(message); }),
+  };
+}
+
+afterEach(() => { cleanup(); vi.unstubAllGlobals(); vi.restoreAllMocks(); });
+
+describe("useGoals live state", () => {
+  it("updates from full folder pushes, including deletion, without another GET", async () => {
+    const fetch = vi.fn(async () => response([goal("paused")]));
+    vi.stubGlobal("fetch", fetch);
+    const h = harness();
+    const { result } = renderHook(() => useGoals(cwd), { wrapper: h.Wrapper });
+    await waitFor(() => expect(result.current.goals[0]?.status).toBe("paused"));
+    h.push({ type: "goals_update", cwd: "/other", goals: [] });
+    expect(result.current.goals).toHaveLength(1);
+    h.push({ type: "goals_update", cwd, goals: [{ ...goal("achieved"), lastKnownTurnsUsed: 1 }] });
+    expect(result.current.goals[0]).toMatchObject({ status: "achieved", lastKnownTurnsUsed: 1 });
+    h.push({ type: "goals_update", cwd, goals: [] });
+    expect(result.current.goals).toEqual([]);
+    expect(fetch).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not let a slow initial GET overwrite a newer push", async () => {
+    let resolve!: (r: Response) => void;
+    vi.stubGlobal("fetch", vi.fn(() => new Promise<Response>((r) => { resolve = r; })));
+    const h = harness();
+    const { result } = renderHook(() => useGoals(cwd), { wrapper: h.Wrapper });
+    h.push({ type: "goals_update", cwd, goals: [goal("pursuing")] });
+    await act(async () => { resolve(response([goal("paused")])); });
+    expect(result.current.goals[0]?.status).toBe("pursuing");
+    expect(result.current.loading).toBe(false);
+  });
+
+  it("ignores a late response after changing folders and clears old goals", async () => {
+    let oldResolve!: (r: Response) => void;
+    const fetch = vi.fn().mockImplementationOnce(() => new Promise<Response>((r) => { oldResolve = r; }))
+      .mockResolvedValue(response([]));
+    vi.stubGlobal("fetch", fetch);
+    const h = harness();
+    const { result, rerender } = renderHook(({ folder }) => useGoals(folder), { wrapper: h.Wrapper, initialProps: { folder: cwd } });
+    rerender({ folder: "/other" });
+    await waitFor(() => expect(result.current.loading).toBe(false));
+    await act(async () => { oldResolve(response([goal("paused")])); });
+    expect(result.current.goals).toEqual([]);
+  });
+
+  it("recovers missed pushes on reconnect and coalesces focus/visibility events", async () => {
+    const fetch = vi.fn(async () => response([goal("paused")]));
+    vi.stubGlobal("fetch", fetch);
+    const h = harness("disconnected");
+    const { result, rerender } = renderHook(() => useGoals(cwd), { wrapper: h.Wrapper });
+    await waitFor(() => expect(result.current.loading).toBe(false));
+    fetch.mockImplementation(async () => response([goal("pursuing")]));
+    h.connect(); rerender();
+    act(() => {
+      window.dispatchEvent(new Event("focus"));
+      document.dispatchEvent(new Event("visibilitychange"));
+      window.dispatchEvent(new Event("focus"));
+    });
+    await waitFor(() => expect(result.current.goals[0]?.status).toBe("pursuing"));
+    expect(fetch).toHaveBeenCalledTimes(2);
+  });
+
+  it("aborts an in-flight read and removes the subscription on unmount", async () => {
+    let signal: AbortSignal | undefined;
+    const fetch = vi.fn((_url: string, init: RequestInit) => { signal = init.signal as AbortSignal; return new Promise<Response>(() => {}); });
+    vi.stubGlobal("fetch", fetch);
+    const h = harness();
+    const { unmount } = renderHook(() => useGoals(cwd), { wrapper: h.Wrapper });
+    expect(h.listeners.size).toBe(1);
+    unmount();
+    expect(signal?.aborted).toBe(true);
+    expect(h.listeners.size).toBe(0);
+  });
+
+  it("cancels scheduled focus recovery on unmount", async () => {
+    const fetch = vi.fn(async () => response([]));
+    vi.stubGlobal("fetch", fetch);
+    const h = harness();
+    const { unmount } = renderHook(() => useGoals(cwd), { wrapper: h.Wrapper });
+    await waitFor(() => expect(fetch).toHaveBeenCalledTimes(1));
+    act(() => { window.dispatchEvent(new Event("focus")); });
+    unmount();
+    await new Promise((r) => setTimeout(r, 150));
+    expect(fetch).toHaveBeenCalledTimes(1);
+  });
+});
