+import { render, screen, fireEvent, cleanup, within } from '@testing-library/react';
+import { describe, it, expect, vi, afterEach } from 'vitest';
+interface FixtureNode { id: string; label: string; state: string; children?: FixtureNode[] }
+interface FixtureEvent { eventType: string; timestamp: number; data: { available: boolean; snapshot: { generatedAt: number; runs: FixtureNode[] } } }
+const {events} = vi.hoisted<{events: FixtureEvent[]}>(()=>({events:[{eventType:'native_subagents_snapshot',timestamp:Date.now(),data:{available:true,snapshot:{generatedAt:Date.now(),runs:[{id:'test-parent',label:'测试父任务',state:'running',children:[{id:'test-child',label:'测试子任务',state:'queued'}]}]}}}]}));
+vi.mock('@blackbelt-technology/dashboard-plugin-runtime/context',()=>({useSessionEvents:()=>events,usePluginSend:()=>()=>{}}));
+import { NativeSubagents } from '../split/NativeSubagents.js';
+afterEach(cleanup);
+describe('node selection with explicit test fixtures (not live execution)',()=>{
+ it('preserves selection when an earlier sibling is inserted',()=>{
+  const original=events[0].data.snapshot;
+  const view=render(<NativeSubagents sessionId="fixture-session"/>);
+  fireEvent.click(screen.getByRole('button',{name:/测试子任务/}));
+  try {
+   events[0].data.snapshot={...original,runs:[{id:'new-root',label:'新增任务',state:'queued',children:[]},...original.runs]};
+   view.rerender(<NativeSubagents sessionId="fixture-session"/>);
+   expect(within(screen.getByRole('complementary',{name:'任务详情'})).getByText('test-child')).toBeTruthy();
+  } finally {events[0].data.snapshot=original;}
+ });
+ it('keeps all deeper descendants hidden when root is collapsed',()=>{
+  const original=events[0].data.snapshot;
+  try {
+   const deep={id:'deep',label:'深层节点',state:'running',children:[]};
+   events[0].data.snapshot={...original,runs:[{...original.runs[0],children:[{...original.runs[0].children![0],children:[deep]}]}]};
+   render(<NativeSubagents sessionId="fixture-session"/>);
+   fireEvent.click(screen.getByRole('button',{name:'展开 测试子任务 的子任务'}));
+   expect(screen.getByRole('button',{name:/深层节点/})).toBeTruthy();
+   fireEvent.click(screen.getByRole('button',{name:'收起 测试父任务 的子任务'}));
+   expect(screen.queryByRole('button',{name:/深层节点/})).toBeNull();
+  } finally {events[0].data.snapshot=original;}
+ });
+ it('hides unselected details and supports collapse and close',()=>{
+  render(<NativeSubagents sessionId="fixture-session"/>);
+  expect(screen.queryByRole('complementary',{name:'任务详情'})).toBeNull();
+  fireEvent.click(screen.getByRole('button',{name:'收起 测试父任务 的子任务'}));
+  expect(screen.queryByRole('button',{name:/测试子任务/})).toBeNull();
+  fireEvent.click(screen.getByRole('button',{name:'展开 测试父任务 的子任务'}));
+  fireEvent.click(screen.getByRole('button',{name:/测试子任务/}));
+  fireEvent.click(screen.getByRole('button',{name:'关闭任务详情'}));
+  expect(screen.queryByRole('complementary',{name:'任务详情'})).toBeNull();
+ });
+ it('selects a child, preserves parent attribution, and switches usage view',()=>{
+  render(<NativeSubagents sessionId="fixture-session"/>);
+  fireEvent.click(screen.getByRole('button',{name:/测试子任务/}));
+  const panel=within(screen.getByRole('complementary',{name:'任务详情'}));
+  expect(panel.getByText('test-child')).toBeTruthy();
+  expect(panel.getByText('测试父任务')).toBeTruthy();
+  fireEvent.click(panel.getByRole('button',{name:'用量'}));
+  expect(panel.getByText('该快照未提供用量数据。')).toBeTruthy();
+  fireEvent.click(screen.getByRole('button',{name:'列表'}));
+  expect(screen.getByRole('button',{name:'列表'}).getAttribute('aria-pressed')).toBe('true');
+ });
+});
