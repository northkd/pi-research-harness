+++ b/packages/server/src/__tests__/goal-turn-budget.test.ts
@@ -0,0 +1,60 @@
+import { describe, expect, it, vi } from "vitest";
+import { createGoalTurnBudgetSync, nativeTurnLimit } from "../goal/goal-turn-budget.js";
+
+function harness(options: { ack?:boolean; mutate?:()=>void; ackOverride?:Record<string,unknown>; ackSession?:string } = {}) {
+  let linked="g";
+  const goal={id:"g",objective:"Task",driverSessionId:"s",budget:{maxTurns:30},totalTurnsUsed:20,
+    liveGoalCursor:{sessionId:"s",engineGoalId:"e",turnsUsed:20,observedAt:10}};
+  let sync:ReturnType<typeof createGoalTurnBudgetSync>;
+  const sendEvent=vi.fn((_sid:string,_event:string,data:Record<string,unknown>)=>{
+    queueMicrotask(()=>{
+      options.mutate?.();
+      if(options.ack!==false) sync.handleAck({payload:{...data,accepted:true,engineGoalId:"e",pending:data.forNewGoal===true,...options.ackOverride}},options.ackSession??"s");
+    }); return true;
+  });
+  sync=createGoalTurnBudgetSync({store:{list:async()=>[goal]} as any,lookupSession:()=>({goalId:linked,cwd:"/project"}),sendEvent,sendPrompt:vi.fn(),timeoutMs:15,warn:vi.fn()});
+  return {sync,goal,sendEvent,unlink:()=>{linked="other";}};
+}
+describe("native turn budget synchronization",()=>{
+  it("maps configured cumulative 30 to native30 at used20 and native10 for a fresh driver",()=>{
+    const h=harness();
+    expect(nativeTurnLimit(h.goal as any,"s",false)).toBe(30);
+    expect(nativeTurnLimit(h.goal as any,"new",true)).toBe(10);
+    h.goal.totalTurnsUsed=25; h.goal.liveGoalCursor.turnsUsed=5;
+    expect(nativeTurnLimit(h.goal as any,"s",false)).toBe(10);
+  });
+  it("waits for the native acknowledgement before allowing Resume",async()=>{
+    const h=harness(); expect(await h.sync.prepare("s")).toBe(true);
+    expect(h.sendEvent.mock.calls[0][2]).toMatchObject({maxTurns:30,engineGoalId:"e",objective:"Task"});
+  });
+  it("refuses Resume for an old extension that ignores the event",async()=>{
+    const h=harness({ack:false}); expect(await h.sync.prepare("s")).toBe(false);
+  });
+  it("refuses a driver or budget change while acknowledgement is pending",async()=>{
+    let h:ReturnType<typeof harness>; h=harness({mutate:()=>h.unlink()});
+    expect(await h.sync.prepare("s")).toBe(false);
+    h=harness({mutate:()=>{h.goal.budget.maxTurns=40;}});
+    expect(await h.sync.prepare("s")).toBe(false);
+  });
+  it("does not restart an exhausted cumulative budget",async()=>{
+    const h=harness(); h.goal.totalTurnsUsed=30; h.goal.liveGoalCursor.turnsUsed=30;
+    expect(await h.sync.prepare("s")).toBe(false);
+    expect(h.sendEvent.mock.calls[0][2]).toMatchObject({maxTurns:30});
+  });
+  it.each(["status","generation","engine","cursor-source"])("refuses a later %s change during the acknowledgement",async(field)=>{
+    let h:ReturnType<typeof harness>; h=harness({mutate:()=>{
+      if(field==="engine")h.goal.liveGoalCursor.engineGoalId="new-engine";
+      else if(field==="cursor-source")h.goal.liveGoalCursor.sessionId="other-session";
+      else (h.goal as any)[field]=field==="status"?"cleared":2;
+    }});
+    expect(await h.sync.prepare("s")).toBe(false);
+  });
+  it("rejects acknowledgements from another connection or engine",async()=>{
+    expect(await harness({ackSession:"other-session"}).sync.prepare("s")).toBe(false);
+    expect(await harness({ackOverride:{engineGoalId:"old-engine"}}).sync.prepare("s")).toBe(false);
+  });
+  it("does not kick off a fresh driver when no cumulative turns remain",async()=>{
+    const h=harness(); h.goal.totalTurnsUsed=30;
+    expect(await h.sync.prepare("s",true)).toBe(false); expect(h.sendEvent).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/server/src/__tests__/memory-event-store.history-replacement.test.ts b/packages/server/src/__tests__/memory-event-store.history-replacement.test.ts
