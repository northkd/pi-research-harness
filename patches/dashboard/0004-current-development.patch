+  assert.equal(h.continuations().length, 0);
+});
+
+test("judge input retains a long reply's explicit unfinished conclusion", async () => {
+  const h = await harness(goal({ status: "active" }));
+  verdicts.push('{"done":false,"blocked":true,"reason":"Final required check is blocked"}');
+  await h.end(`Saved preliminary details. ${"x".repeat(7000)} FINAL_REQUIRED_DELIVERABLE_NOT_PRODUCED`);
