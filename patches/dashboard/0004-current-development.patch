+  assert.equal(h.state().status, "paused"); assert.equal(h.state().lastVerdict, "blocked");
+  assert.equal(h.state().turnsUsed, 2); assert.equal(h.continuations().length, 0);
+  assert.match(h.state().pausedReason, /input/i);
+});
+
+test("contradictory done and blocked flags resolve to paused, never achieved", async () => {
+  const h = await harness(goal({ status: "active" }));
+  verdicts.push('{"done":true,"blocked":true,"reason":"Blocked before producing deliverables"}');
+  await h.end("The deliverables are not yet available.");
+  assert.equal(h.state().status, "paused"); assert.equal(h.state().lastVerdict, "blocked");
+});
+
+test("completion with deliverables becomes done", async () => {
+  const h = await harness(goal({ status: "active" }));
+  verdicts.push('{"done":true,"blocked":false,"reason":"Both requested cards and limitations are delivered"}');
+  await h.end("Both requested evidence cards and their limitations are saved.");
+  assert.equal(h.state().status, "done"); assert.equal(h.continuations().length, 0);
+});
+
+test("unfinished unblocked work continues and counts the next turn once", async () => {
+  const h = await harness(goal({ status: "active" }));
+  verdicts.push('{"done":false,"blocked":false,"reason":"Second card is still being prepared"}');
+  await h.end("The first card is saved; continuing the second.");
+  assert.equal(h.state().status, "active"); assert.equal(h.state().turnsUsed, 2); assert.equal(h.continuations().length, 1);
+});
+
+test("a manual pause while the judge waits cannot be overwritten by a late DONE", async () => {
+  const h = await harness(goal({ status: "active" }));
