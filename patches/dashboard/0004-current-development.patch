+                      </div>
+                    </div>
+                    <div className="shrink-0 text-right">
+                      <div className="font-mono text-sm">
+                        {rowCost(entry.billing)}
+                      </div>
+                      <button
+                        type="button"
+                        className="mt-1 text-xs text-[var(--accent-blue)]"
+                        onClick={() => {
+                          setFolder(entry.cwd);
+                          setView("sessions");
