diff --git a/packages/server/src/__tests__/session-rename-reattach.test.ts b/packages/server/src/__tests__/session-rename-reattach.test.ts
new file mode 100644
index 00000000..e226a2b4
--- /dev/null
+++ b/packages/server/src/__tests__/session-rename-reattach.test.ts
@@ -0,0 +1,113 @@
+import { describe, expect, it, vi } from "vitest";
+import type { BrowserHandlerContext } from "../browser-handlers/handler-context.js";
+import { handleRenameSession } from "../browser-handlers/session-meta-handler.js";
+import { type EventWiringDeps, wireEvents } from "../event-wiring.js";
+import { createMemoryEventStore } from "../persistence/memory-event-store.js";
+import type { PiGateway } from "../pi/pi-gateway.js";
+import { createMemorySessionManager } from "../session/memory-session-manager.js";
+
+function rig() {
+  const sessionManager = createMemorySessionManager();
+  const sendToSession = vi.fn<PiGateway["sendToSession"]>(() => false);
+  const piGateway = { sendToSession } as unknown as PiGateway;
+  const broadcastSessionUpdated = vi.fn();
+  wireEvents({
+    sessionManager,
+    eventStore: createMemoryEventStore(() => false),
+    piGateway,
+    browserGateway: {
+      broadcastSessionUpdated,
+      clearPendingRequestsForSession: vi.fn(),
+    },
+    preferencesStore: { getAutoNameSessions: () => true },
+  } as unknown as EventWiringDeps);
+  const ctx = {
+    sessionManager,
+    piGateway,
+    broadcast: vi.fn(),
+  } as unknown as BrowserHandlerContext;
+  return { sessionManager, piGateway, sendToSession, ctx };
+}
+
+describe("offline rename survives bridge reattach", () => {
+  it.each([
+    "Renamed history",
+    "",
+  ])("preserves and replays the user's name %j, including a cleared name", (name) => {
+    const { sessionManager, piGateway, sendToSession, ctx } = rig();
+    sessionManager.register({
+      id: "s1",
+      cwd: "/fixture",
+      source: "tui",
+      name: "Old log name",
+    });
+    sessionManager.unregister("s1");
+    handleRenameSession({ type: "rename_session", sessionId: "s1", name }, ctx);
+    expect(sessionManager.get("s1")?.status).toBe("ended");
+    expect(sendToSession).toHaveReturnedWith(false);
+
+    // The bridge reconnects with its unchanged JSONL name. onChange is also
+    // the persistence entry point, so observe what that next save receives.
+    const savedNames: Array<{ name?: string; nameSource?: string }> = [];
+    sessionManager.onChange = () => {
+      const current = sessionManager.get("s1");
+      savedNames.push({ name: current?.name, nameSource: current?.nameSource });
+    };
+    sessionManager.register({
+      id: "s1",
+      cwd: "/fixture",
+      source: "tui",
+      name: "Old log name",
+      registerReason: "reattach",
+    });
+    expect(savedNames).toEqual([
+      { name: name || undefined, nameSource: "user" },
+    ]);
+
+    sendToSession.mockClear().mockReturnValue(true);
+    piGateway.onSessionRegistered?.("s1", "/fixture");
+    expect(sendToSession).toHaveBeenCalledWith("s1", {
+      type: "rename_session",
+      sessionId: "s1",
+      name,
+    });
+
+    // The bridge acknowledges a dashboard rename without a provenance field.
+    piGateway.onEvent?.("s1", {
+      type: "session_name_update",
+      sessionId: "s1",
+      name,
+    });
+    expect(sessionManager.get("s1")?.nameSource).toBe("user");
+  });
+
+  it.each([
+    undefined,
+    "auto",
+  ] as const)("accepts the bridge name and avoids user rename replay for source %j", (nameSource) => {
+    const { sessionManager, piGateway, sendToSession } = rig();
+    sessionManager.register({
+      id: "s1",
+      cwd: "/fixture",
+      source: "tui",
+      name: "Earlier name",
+    });
+    sessionManager.update("s1", { nameSource });
+    sessionManager.register({
+      id: "s1",
+      cwd: "/fixture",
+      source: "tui",
+      name: "Fresh Pi name",
+      registerReason: "reattach",
+    });
+
+    expect(sessionManager.get("s1")?.name).toBe("Fresh Pi name");
+    expect(sessionManager.get("s1")?.nameSource).toBe(nameSource);
+    piGateway.onSessionRegistered?.("s1", "/fixture");
+    expect(
+      sendToSession.mock.calls.some(
+        ([, message]) => message.type === "rename_session",
+      ),
+    ).toBe(false);
+  });
+});
