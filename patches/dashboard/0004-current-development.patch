diff --git a/packages/server/src/goal/goal-turn-budget.ts b/packages/server/src/goal/goal-turn-budget.ts
new file mode 100644
index 00000000..d11cc554
--- /dev/null
+++ b/packages/server/src/goal/goal-turn-budget.ts
@@ -0,0 +1,94 @@
+import { randomUUID } from "node:crypto";
+import type { GoalRecord } from "@blackbelt-technology/pi-dashboard-shared/types.js";
+import type { GoalStore } from "./goal-store.js";
+
+export const GOAL_TURN_BUDGET_EVENT = "pi-goal-hermes:turn-budget";
+export const GOAL_BUDGET_ACK = "goal_budget_ack";
+const oneLine = (text: string) => text.replace(/\s+/g, " ").trim();
+
+/** Translate a cumulative Goal budget into the current engine's local cap. */
+export function nativeTurnLimit(goal: GoalRecord, sessionId: string, forNewGoal: boolean): number | null {
+  const cap = goal.budget?.maxTurns;
+  if (cap === undefined || cap <= 0) return null;
+  if (!Number.isSafeInteger(cap)) throw new Error("maxTurns must be a positive safe integer");
+  const local = !forNewGoal && goal.liveGoalCursor?.sessionId === sessionId ? goal.liveGoalCursor.turnsUsed : 0;
+  const spent = Math.max(goal.totalTurnsUsed ?? 0, local);
+  return local + Math.max(0, cap - spent);
+}
+
+/** Session-scoped ACK gate; an unsupported engine never receives a kickoff. */
+export function createGoalTurnBudgetSync(deps: {
+  store: Pick<GoalStore, "list">;
+  lookupSession: (sessionId: string) => { cwd?: string; goalId?: string } | null | undefined;
+  sendEvent: (sessionId: string, event: string, data: Record<string, unknown>) => boolean;
+  sendPrompt: (sessionId: string, text: string) => unknown;
+  refresh?: () => Promise<void>;
+  timeoutMs?: number;
+  warn?: (message: string) => void;
+}) {
+  const pending = new Map<string, { sessionId: string; objective: string; maxTurns: number; engineGoalId?: string; forNewGoal: boolean; finish: (ok: boolean) => void }>();
+
+  function handleAck(msg: unknown, sessionId: string): void {
+    const data = (msg as { payload?: Record<string, unknown> } | null)?.payload;
+    if (!data || typeof data.requestId !== "string") return;
+    const waiter = pending.get(data.requestId);
+    if (!waiter || waiter.sessionId !== sessionId) return;
+    waiter.finish(data.accepted === true && data.objective === waiter.objective && data.maxTurns === waiter.maxTurns
+      && (waiter.forNewGoal ? data.pending === true : typeof data.engineGoalId === "string"
+        && (!waiter.engineGoalId || data.engineGoalId === waiter.engineGoalId)));
+  }
+
+  async function prepare(sessionId: string, forNewGoal = false): Promise<boolean> {
+    try {
+      if (!forNewGoal) await deps.refresh?.();
+      const session = deps.lookupSession(sessionId);
+      if (!session?.cwd || !session.goalId) return true; // unlinked command
+      const { cwd, goalId } = session;
+      const goal = (await deps.store.list(cwd)).find(g => g.id === goalId);
+      if (!goal || goal.driverSessionId !== sessionId) return false;
+      const maxTurns = nativeTurnLimit(goal, sessionId, forNewGoal);
+      if (maxTurns === null) return true;
+      if (maxTurns === 0) {
+        if (!forNewGoal) deps.sendPrompt(sessionId, "/goal pause");
+        deps.warn?.(`Goal ${goalId}: cumulative turn budget exhausted`);
+        return false;
+      }
+      const objective = oneLine(goal.objective);
+      const configuredCap = goal.budget?.maxTurns;
+      const rawObjective = goal.objective;
+      const requestedStatus = goal.status;
+      const generation = goal.generation;
+      const engineGoalId = !forNewGoal && goal.liveGoalCursor?.sessionId === sessionId ? goal.liveGoalCursor.engineGoalId : undefined;
+      const requestId = randomUUID();
+      const acknowledged = await new Promise<boolean>((resolve) => {
+        const finish = (ok: boolean) => { clearTimeout(timer); pending.delete(requestId); resolve(ok); };
+        const timer = setTimeout(() => finish(false), deps.timeoutMs ?? 5000);
+        pending.set(requestId, {sessionId, objective, maxTurns, engineGoalId, forNewGoal, finish});
+        try {
+          if (!deps.sendEvent(sessionId, GOAL_TURN_BUDGET_EVENT, {requestId, objective, maxTurns, engineGoalId, forNewGoal})) finish(false);
+        } catch { finish(false); }
+      });
+      if (!acknowledged) {
+        deps.warn?.(`Goal ${goalId}: native turn-budget acknowledgement missing or rejected; reload session before retry`);
+        return false;
+      }
+      // A handover or budget edit while waiting must invalidate this action.
+      const currentSession = deps.lookupSession(sessionId);
+      const current = (await deps.store.list(cwd)).find(g => g.id === goalId);
+      if (currentSession?.goalId !== goalId || currentSession.cwd !== cwd || current?.driverSessionId !== sessionId
+        || current.objective !== rawObjective || current.budget?.maxTurns !== configuredCap
+        || current.status !== requestedStatus || current.generation !== generation
+        || (!forNewGoal && engineGoalId && (current.liveGoalCursor?.sessionId !== sessionId || current.liveGoalCursor.engineGoalId !== engineGoalId))) return false;
+      const spent = Math.max(current.totalTurnsUsed ?? 0, forNewGoal ? 0 : current.liveGoalCursor?.sessionId === sessionId ? current.liveGoalCursor.turnsUsed : 0);
+      if (spent >= (current.budget?.maxTurns ?? Infinity)) {
+        if (!forNewGoal) deps.sendPrompt(sessionId, "/goal pause");
+        return false;
+      }
+      return true;
+    } catch (error) {
+      deps.warn?.(`Goal turn-budget preparation failed: ${String(error)}`);
+      return false;
+    }
+  }
+  return { prepare, handleAck };
+}
