+  it("W3 slow-draining paced branch keeps production interactive state and notification after terminal replay", async () => {
+    const rig = createRig(); await rig.start();
+    const send = rig.browser.send.bind(rig.browser);
+    rig.browser.send = (data: string) => {
+      const bytes = Buffer.byteLength(data); rig.browser.bufferedAmount += bytes;
+      send(data);
+      setImmediate(() => { rig.browser.bufferedAmount = Math.max(0, rig.browser.bufferedAmount - bytes); });
+    };
+    rig.browserGateway.trackUiRequest(SID, "paced-ui", "input", { title: "keep" });
+    act(() => {
+      rig.piGateway.onEvent(SID, { type: "prompt_request", sessionId: SID, promptId: "paced-ask", prompt: { type: "input", question: "keep" } });
+      rig.piGateway.onEvent(SID, { type: "notify", sessionId: SID, notifyId: "paced-notice", message: "keep" });
+    });
+    const large = Array.from({ length: 1400 }, (_, i) => ({ ...entry(`paced-${i}`, "user"), message: { role: "user", content: "x".repeat(4000) } }));
+    await rig.navigate(large);
+    await act(async () => { await vi.advanceTimersByTimeAsync(200); });
+    expect(rig.messages()).toHaveLength(1400);
+    expect(rig.browserGateway.getDroppedFrameStats().total).toBe(0);
+    expect(rig.states.current.get(SID)?.interactiveRequests.map((request) => request.requestId).sort()).toEqual(["paced-ask", "paced-ui"]);
+    expect(rig.states.current.get(SID)?.messages.filter((message) => message.id === "ui-paced-notice")).toHaveLength(1);
+  });
+
+  it("does not reapply queued pre-navigation live transcript after the authoritative replay", async () => {
+    const rig = createRig(); await rig.start();
+    await act(async () => {
+      rig.forward("message_start", { entryId: "outgoing-user", message: { role: "user", content: "discarded branch" } });
+      // Intentionally no animation frame between live delivery and navigation.
+      for (const handler of rig.handlers.get("session_tree") ?? []) {
+        await handler({ type: "session_tree", newLeafId: "a2", oldLeafId: "outgoing-user" }, rig.ctx);
+      }
+      await vi.advanceTimersByTimeAsync(25);
+    });
+    rig.expectBranch(["u1", "a1", "u2", "a2"]);
+  });
+
+  it("an outgoing image fit completion after wipe cannot resurrect messages or alter another session", async () => {
+    let completeFit!: (result: any) => void;
+    const pool = { fit: vi.fn(() => new Promise((resolve) => { completeFit = resolve; })) };
+    const rig = createRig(pool); await rig.start();
+    act(() => {
+      rig.forward("message_start", { entryId: "outgoing-image", message: { role: "user", content: [
+        { type: "image", data: "T1VUR09JTkc=", mimeType: "image/png" },
+      ] } });
+    });
+    expect(pool.fit).toHaveBeenCalledTimes(1);
+    await rig.navigate(fullBranch().slice(0, 2)); rig.expectBranch(["u1", "a1"]);
+    const otherBefore = rig.eventStore.getEvents(OTHER, 1);
+    await act(async () => {
+      completeFit({ results: [{ blockIndex: 0, data: "RklUVEVE", mimeType: "image/png" }] });
+      await vi.advanceTimersByTimeAsync(25);
+    });
+    rig.expectBranch(["u1", "a1"]);
+    expect(rig.messages().some((message) => message.images?.length)).toBe(false);
+    expect(rig.eventStore.getEvents(OTHER, 1)).toEqual(otherBefore);
+    // Superseded fit ownership now excludes even a harmless orphan derivative.
+    // Current-generation before/after-commit fitting is covered separately.
+    expect(rig.eventStore.getEvents(SID, 1).filter(({ event }: { event: DashboardEvent }) => event.eventType === "attachment_fitted")).toHaveLength(0);
+    await rig.subscribe(); rig.expectBranch(["u1", "a1"]);
+  });
+
+  it("old paginated subscribe and backfill generations cannot overwrite a branch replacement", async () => {
+    const rig = createRig(); await rig.start();
+    // Exceed the real replay batch size but keep events small and visible.
+    const longBranch = Array.from({ length: 320 }, (_, i) => entry(`old-${i}`, i % 2 ? "assistant" : "user", i ? `old-${i - 1}` : null));
+    await rig.navigate(longBranch);
+    const fresh = [entry("fresh-u", "user"), entry("fresh-a", "assistant", "fresh-u")];
+    await act(async () => {
+      rig.browser.request({ type: "subscribe", sessionId: SID, lastSeq: 0 });
+      // handleSubscribe has sent only batch 1; sendEventBatches yielded.
+      for (const handler of rig.handlers.get("session_tree") ?? []) {
+        rig.ctx.sessionManager.getBranch = () => fresh;
+        rig.ctx.sessionManager.getLeafId = () => "fresh-a";
+        await handler({ type: "session_tree", newLeafId: "fresh-a" }, rig.ctx);
+      }
+      await vi.advanceTimersByTimeAsync(25);
+    });
+    rig.expectBranch(["fresh-u", "fresh-a"]);
+  });
+
+  it("refuses missing/ended owners and malformed snapshots before wiping", async () => {
+    const rig = createRig(); await rig.start(); const before = rig.eventStore.getEvents(SID, 1);
+    for (const events of [null, [{}]]) rig.piGateway.onEvent(SID, { type: "session_branch_replay", sessionId: SID, entryCount: 0, events });
+    rig.piGateway.onEvent("unknown", { type: "session_branch_replay", sessionId: "unknown", entryCount: 0, events: [] });
+    expect(rig.eventStore.getEvents(SID, 1)).toEqual(before);
+    rig.sessionManager.update(SID, { status: "ended" });
+    rig.piGateway.onEvent(SID, { type: "session_branch_replay", sessionId: SID, entryCount: 0, events: [] });
+    expect(rig.eventStore.getEvents(SID, 1)).toEqual(before);
+  });
+});
