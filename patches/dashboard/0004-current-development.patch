@@ -0,0 +1,937 @@
+import { EventEmitter } from "node:events";
+import type { ServerToBrowserMessage } from "@blackbelt-technology/pi-dashboard-shared/browser-protocol.js";
+import { BRANCH_TRANSFER_TIMEOUT_MS } from "@blackbelt-technology/pi-dashboard-shared/protocol.js";
+import type { DashboardEvent } from "@blackbelt-technology/pi-dashboard-shared/types.js";
+import { getSessionEvents } from "@blackbelt-technology/dashboard-plugin-runtime";
+import { act, cleanup, renderHook } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { SessionState } from "../../lib/chat/event-reducer.js";
+import { useMessageHandler } from "../useMessageHandler.js";
+
+// Only Pi/socket fixtures and unrelated bridge activation/probes are replaced.
+// The registered bridge handlers, branch synthesis, wireEvents, event store,
+// BrowserGateway (including handleSubscribe), client replay handler and reducer
+// are production code. No fixture constructs a correct history response.
+const transport = vi.hoisted(() => ({
+  instances: [] as Array<{ options: any; send: (message: any) => void }>,
+  route: undefined as ((message: any) => void) | undefined,
+  sent: [] as any[],
+}));
+vi.mock("../../../../extension/src/connection.js", () => ({
+  ConnectionManager: class {
+    isConnected = false;
+    constructor(public options: any) { transport.instances.push(this); }
+    send(message: any) {
+      const wire = JSON.parse(JSON.stringify(message));
+      transport.sent.push(wire);
+      transport.route?.(wire);
+    }
+    connect() { this.isConnected = true; }
+    disconnect() { this.isConnected = false; }
+    shouldSuppressAutoStart() { return true; }
+    getDroppedBufferedCount() { return 0; }
+    getDroppedInboundCount() { return 0; }
+  },
+}));
+vi.mock("../../../../extension/src/provider-register.js", () => ({
+  activate: vi.fn(), onProviderChanged: vi.fn(), reloadProviders: vi.fn(),
+  buildProviderCatalogue: () => [], toModelInfo: (model: unknown) => model,
+}));
+vi.mock("../../../../extension/src/role-manager.js", () => ({
+  activate: vi.fn(), lookupRole: vi.fn(), resolveNamingModel: vi.fn(),
+}));
+vi.mock("../../../../extension/src/role-model-tools.js", () => ({ registerRoleModelTools: vi.fn() }));
+vi.mock("../../../../extension/src/openspec-cli-shim.js", () => ({ provisionOpenspecCli: vi.fn() }));
+vi.mock("../../../../extension/src/server-auto-start.js", () => ({ autoStartServer: async () => ({}) }));
+vi.mock("../../../../extension/src/server-launcher.js", () => ({ launchServer: vi.fn() }));
+vi.mock("../../../../extension/src/process-metrics.js", () => ({
+  startMetricsMonitor: vi.fn(), stopMetricsMonitor: vi.fn(), collectMetrics: () => ({}),
+}));
+vi.mock("../../../../extension/src/model-tracker.js", () => ({
+  resetReconnectCaches: vi.fn(), sendCwdMissingIfChanged: vi.fn(), sendGitInfoIfChanged: vi.fn(),
+  sendModelUpdateIfChanged: vi.fn(), sendPiVersionIfChanged: vi.fn(), sendSessionNameIfChanged: vi.fn(),
+  defaultReadPiVersion: () => undefined,
+}));
+vi.mock("../../../../extension/src/vcs-info.js", () => ({ detectIsGitRepo: () => false, gatherGitInfo: () => null }));
+vi.mock("@earendil-works/pi-tui", () => ({ Loader: class {} }));
+
+// Runtime paths keep foreign source outside the client-only rootDir without
+// Vite rewriting new URL(..., import.meta.url) into an HTTP asset URL.
+const extensionSource = `${process.cwd()}/packages/extension/src/`;
+const serverSource = `${process.cwd()}/packages/server/src/`;
+const { default: activateBridge } = await import(`${extensionSource}bridge.ts`);
+const { replaySessionEntries, sendStateSync } = await import(`${extensionSource}session-sync.ts`);
+const { wireEvents } = await import(`${serverSource}event-wiring.ts`);
+const { createBrowserGateway } = await import(`${serverSource}pairing/browser-gateway.ts`);
+const { createMemoryEventStore } = await import(`${serverSource}persistence/memory-event-store.ts`);
+const { createMemorySessionManager } = await import(`${serverSource}session/memory-session-manager.ts`);
+
+const SID = "branch-s1";
+const OTHER = "branch-s2";
+function entry(id: string, role: "user" | "assistant", parentId: string | null = null) {
+  return {
+    type: "message", id, parentId, timestamp: "2026-01-01T00:00:00.000Z",
+    message: { role, content: [{ type: "text", text: id }], ...(role === "assistant" ? { stopReason: "stop" } : {}) },
+  };
+}
+const fullBranch = () => [entry("u1", "user"), entry("a1", "assistant", "u1"), entry("u2", "user", "a1"), entry("a2", "assistant", "u2")];
+const metadata = (id = "meta") => ({ type: "thinking_level_change", id, parentId: null, thinkingLevel: "max" });
+
+class BrowserSocket extends EventEmitter {
+  OPEN = 1;
+  readyState = 1;
+  bufferedAmount = 0;
+  frames: ServerToBrowserMessage[] = [];
+  constructor(private receive: (message: ServerToBrowserMessage) => void) { super(); }
+  send(serialized: string) {
+    const message = JSON.parse(serialized) as ServerToBrowserMessage;
+    this.frames.push(message);
+    this.receive(message);
+  }
+  request(message: unknown) { this.emit("message", JSON.stringify(message)); }
+}
+
+function createRig(fitWorkerPool?: any, directoryService?: any, retention?: number) {
+  const sessionManager = createMemorySessionManager();
+  const eventStore = createMemoryEventStore(() => false, undefined, retention);
+  const registeredConnections = new Set<string>();
+  const piGateway: any = { sendToSession: vi.fn((_sessionId, message) => {
+    if (message.type === "session_branch_ack") transport.instances.at(-1)?.options.onMessage(message);
+  }), isConnected: () => true, getConnectedSessionIds: () => [],
+    isSessionConnected: (id: string) => registeredConnections.has(id) && (transport.instances.at(-1) as any)?.isConnected === true && sessionManager.get(id)?.status !== "ended",
+  };
+  const browserGateway = createBrowserGateway(sessionManager, eventStore, piGateway,
+    undefined, undefined, undefined, undefined, directoryService);
+  const order: any = { insert: vi.fn(), moveToFront: vi.fn(), getOrder: () => [OTHER, SID], remove: vi.fn() };
+  wireEvents({
+    sessionManager, eventStore, piGateway, browserGateway, sessionOrderManager: order,
+    preferencesStore: { getPinnedDirectories: () => [] } as any,
+    pendingForkRegistry: {} as any, directoryService: {
+      getOpenSpecData: () => undefined, onDirectoryAdded: async () => ({ sessions: [], openspecData: {} }),
+    } as any,
+    knownSessionIds: new Set(), pendingDashboardSpawns: new Map(), fitWorkerPool,
+  });
+  const states = { current: new Map<string, SessionState>() };
+  const maxSeq = { current: new Map<string, number>() };
+  const loading = { current: new Map<string, boolean>() };
+  const inFlight = { current: new Map<string, boolean>() };
+  function setter<T>(ref: { current: T }) {
+    return (update: T | ((value: T) => T)) => { ref.current = typeof update === "function" ? (update as (value: T) => T)(ref.current) : update; };
+  }
+  const setters: any = new Proxy({
+    setSessionStates: setter(states), setLoadingHistory: setter(loading), setReplayInFlight: setter(inFlight),
+  }, { get: (target, key) => key in target ? (target as any)[key] : vi.fn() });
+  const send = vi.fn();
+  const deps: any = {
+    send, navigate: vi.fn(), clearSpawningCwd: vi.fn(), spawningCwdsRef: { current: new Set() },
+    subscribedRef: { current: new Set() }, pendingTerminalCwdRef: { current: null }, lastCreatedTerminalIdRef: { current: null },
+    maxSeqMapRef: maxSeq, selectedSessionIdRef: { current: SID }, pendingSpawnsRef: { current: new Map() },
+    loadingHistoryTimersRef: { current: new Map() }, replayInFlightTimersRef: { current: new Map() },
+  };
+  const hook = renderHook(() => useMessageHandler(setters, deps));
+  const browser = new BrowserSocket((message) => hook.result.current(message));
+  act(() => { browserGateway.wss.emit("connection", browser as any, undefined); });
+  const handlers = new Map<string, Array<(event: any, ctx: any) => unknown>>();
+  const bus = new EventEmitter();
+  const pi: any = {
+    on: (type: string, callback: (event: any, ctx: any) => unknown) => {
+      const list = handlers.get(type) ?? []; list.push(callback); handlers.set(type, list);
+    },
+    events: { on: (type: string, callback: (...args: any[]) => void) => { bus.on(type, callback); return () => bus.off(type, callback); }, emit: (type: string, data: any) => bus.emit(type, data) },
+    registerCommand: vi.fn(), registerTool: vi.fn(), getSessionName: () => "branch fixture", getCommands: () => [],
+    getThinkingLevel: () => "max", sendUserMessage: vi.fn(), setSessionName: vi.fn(),
+  };
+  let branch: any[] = fullBranch();
+  let leaf: string | null = "a2";
+  let currentSessionId = SID;
+  const getBranch = vi.fn(() => branch);
+  const ctx: any = {
+    cwd: "/branch-fixture", hasUI: false, ui: { setWidget: vi.fn() },
+    sessionManager: {
+      getSessionId: () => currentSessionId, getLeafId: () => leaf, getBranch,
+      getEntries: () => branch, buildSessionContext: () => ({ messages: [] }),
+      appendMessage: (message: any) => {
+        message.id ??= `persisted-${branch.length}`;
+        branch = [...branch, { type: "message", id: message.id, parentId: leaf, timestamp: "2026-01-01T00:00:00.000Z", message }];
+        leaf = message.id;
+        return message.id;
+      },
+    },
+  };
+  transport.route = (message) => {
+    if (message.type === "session_register") {
+      registeredConnections.add(message.sessionId);
+      sessionManager.register({ id: message.sessionId, ...message });
+    }
+    if (message.type === "session_unregister") {
+      registeredConnections.delete(message.sessionId);
+      sessionManager.unregister(message.sessionId);
+    }
+    piGateway.onEvent(message.sessionId, message);
+  };
+  activateBridge(pi);
+  async function emit(type: string, event: any, context = ctx) {
+    await act(async () => {
+      for (const handler of handlers.get(type) ?? []) await handler({ type, ...event }, context);
+      await vi.advanceTimersByTimeAsync(25);
+    });
+  }
+  async function persistMessage(message: any) {
+    // Pi awaits extension message_end, then appends before the deferred send.
+    await act(async () => {
+      for (const handler of handlers.get("message_end") ?? []) await handler({ type: "message_end", message }, ctx);
+      ctx.sessionManager.appendMessage(message);
+      await vi.advanceTimersByTimeAsync(25);
+    });
+  }
+  async function start() {
+    await emit("session_start", { reason: "startup" });
+    expect(transport.sent.some((message) => message.type === "session_register")).toBe(true);
+    expect(handlers.get("session_tree")).toHaveLength(1);
+    await subscribe();
+    transport.sent.length = 0;
+    browser.frames.length = 0;
+    getBranch.mockClear();
+    order.insert.mockClear();
+  }
+  async function subscribe(sessionId = SID, lastSeq = 0) {
+    await act(async () => {
+      browser.request({ type: "subscribe", sessionId, lastSeq });
+      await vi.advanceTimersByTimeAsync(25);
+    });
+  }
+  async function navigate(next: any[], newLeafId: string | null = next.at(-1)?.id ?? null) {
+    const oldLeafId = leaf; branch = next; leaf = newLeafId;
+    await emit("session_tree", { oldLeafId, newLeafId });
+  }
+  function forward(eventType: string, data: Record<string, unknown> = {}, sessionId = SID) {
+    piGateway.onEvent(sessionId, { type: "event_forward", sessionId, event: { eventType, timestamp: 1000, data } });
+  }
+  function messages(sessionId = SID) { return states.current.get(sessionId)?.messages.filter((message) => message.role === "user" || message.role === "assistant") ?? []; }
+  function expectBranch(ids: string[]) {
+    expect(messages().map((message) => message.entryId)).toEqual(ids);
+    expect(new Set(messages().map((message) => message.id)).size).toBe(ids.length);
+    expect(states.current.get(SID)?.needsHistoryReload).not.toBe(true);
+    expect(states.current.get(SID)?.historyGap).not.toBe(true);
+  }
+  return { sessionManager, eventStore, browserGateway, piGateway, browser, states, maxSeq, loading, inFlight, ctx, pi, handlers, getBranch, order,
+    emit, persistMessage, start, subscribe, navigate, forward, messages, expectBranch, send,
+    setCurrentSessionId: (id: string) => { currentSessionId = id; },
+    appendEntry: (next: any) => { branch = [...branch, next]; leaf = next.id; },
+  };
+}
+
