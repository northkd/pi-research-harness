+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { GoalRecord } from "@blackbelt-technology/pi-dashboard-shared/types.js";
+import { wireEvents, type EventWiringDeps } from "../event-wiring.js";
+import { createMemorySessionManager } from "../session/memory-session-manager.js";
+
+afterEach(() => { vi.useRealTimers(); vi.restoreAllMocks(); });
+
+describe("paused goal driver reattachment", () => {
+  for (const hasMetaGoalId of [true, false]) {
+    it(`restores the same driver without priming or resetting its baseline (meta goalId=${hasMetaGoalId})`, async () => {
+      vi.useFakeTimers();
+      const sessionId = "test-only-driver";
+      const goalId = "test-only-goal";
+      const cwd = "/tmp/goal-reattach-no-files";
+      const manager = createMemorySessionManager();
+      manager.restore({ id: sessionId, cwd, source: "dashboard", status: "idle", startedAt: 1, tokensIn: 0, tokensOut: 0, cost: 0, ...(hasMetaGoalId ? { goalId } : {}) });
+      manager.register({ id: sessionId, cwd, source: "dashboard", registerReason: "reattach", pid: 123456789 });
+      if (hasMetaGoalId) expect(manager.get(sessionId)?.goalId).toBe(goalId);
+      const goal = { id: goalId, cwd, objective: "Test only", criteria: [], status: "paused", statusReason: "paused by user", driverSessionId: sessionId, sessionIds: [sessionId], generation: 1, currentDriverBaselineTurns: 7, totalTurnsUsed: 9, createdAt: 1, updatedAt: 1 } satisfies GoalRecord;
+      const goalStore = { list: vi.fn(async () => [goal]), replaceDriver: vi.fn(async () => goal), setInFlightSpawn: vi.fn() };
+      const piGateway = { isSessionConnected: () => true, sendToSession: vi.fn() };
+      const browserGateway = {
+        broadcastSessionUpdated: vi.fn(), broadcastSessionStateReset: vi.fn(), broadcastSessionAdded: vi.fn(), broadcastSessionRemoved: vi.fn(), broadcastToAll: vi.fn(), sendToSubscribers: vi.fn(),
+        pendingResumeRegistry: { consume: () => null },
+        headlessPidRegistry: { linkByPid: () => true, getGoalId: () => goalId, linkSession: vi.fn() },
+      };
+      const primeGoalSession = vi.fn();
+      wireEvents({ sessionManager: manager, eventStore: { hasEvents: () => false, hasHistory: () => false, deleteEventsForSession: vi.fn(), getEvents: () => [] }, piGateway, browserGateway,
+        sessionOrderManager: { insert: vi.fn(), getOrder: () => [sessionId] }, preferencesStore: { getPinnedDirectories: () => [] }, isCompletedFirst: () => false, isQuestionFirst: () => false,
+        directoryService: { refreshFolderHeadsForEnteringKeys: vi.fn(), onDirectoryAdded: async () => ({ sessions: [], openspecData: {} }) }, knownSessionIds: new Set([sessionId]), pendingDashboardSpawns: new Map(), goalStore, primeGoalSession,
+      } as unknown as EventWiringDeps);
+      (piGateway as unknown as { onEvent: (sid: string, message: unknown) => void }).onEvent(sessionId, { type: "session_register", sessionId, cwd, pid: 123456789, registerReason: "reattach" });
+      await vi.waitFor(() => expect(manager.get(sessionId)?.goalId).toBe(goalId));
+      expect(goalStore.replaceDriver).not.toHaveBeenCalled();
+      expect(primeGoalSession).not.toHaveBeenCalled();
+      expect(goal.status).toBe("paused");
+      expect(goal.currentDriverBaselineTurns).toBe(7);
+      vi.clearAllTimers();
+    });
+  }
+});
