@@ -0,0 +1,152 @@
+/** Recover local Hermes snapshots missed by Pi's idle custom-message event path.
+ * Read-only toward Pi: no commands, continuation, judge or model calls. */
+import fs from "node:fs/promises";
+import type { DashboardSession } from "@blackbelt-technology/pi-dashboard-shared/types.js";
+import { mayReadLocalSessionFile, originOf } from "../session/session-origin.js";
+import { mapGoalStatus } from "./goal-status-projector.js";
+import type { GoalStore } from "./goal-store.js";
+
+interface Snapshot {
+  status: string;
+  goal: string;
+  turnsUsed: number;
+  maxTurns: number;
+  lastVerdict: string | null;
+  lastReason: string | null;
+}
+
+interface StateEntry {
+  id: string;
+  parentId?: string;
+  snapshot?: Snapshot;
+  observedAt?: number;
+  engineGoalId?: string;
+}
+
+/** Match the engine's current-branch lookup, never the last off-branch state. */
+function readSnapshot(raw: string, sessionId: string): StateEntry | null {
+  const entries = new Map<string, StateEntry>();
+  let headerSeen = false;
+  let leafId: string | undefined;
+  let explicitLeaf: string | undefined;
+  for (const line of raw.split("\n")) {
+    let entry;
+    try { entry = JSON.parse(line); } catch { continue; }
+    if (!entry || typeof entry !== "object") continue;
+    if (!headerSeen) {
+      if (entry.type !== "session" || entry.id !== sessionId) return null;
+      headerSeen = true;
+      continue;
+    }
+    if (entry.type === "leaf" && typeof entry.entryId === "string") explicitLeaf = entry.entryId;
+    if (typeof entry.id !== "string") continue;
+    const node: StateEntry = { id: entry.id, parentId: typeof entry.parentId === "string" ? entry.parentId : undefined };
+    const g = entry.type === "custom" && entry.customType === "pi-goal-hermes:state" ? entry.data?.goal : null;
+    if (g && typeof g.id === "string" && mapGoalStatus(g.status) && typeof g.goal === "string" &&
+        Number.isInteger(g.turnsUsed) && g.turnsUsed >= 0 &&
+        Number.isInteger(g.maxTurns) && g.maxTurns > 0 && Number.isFinite(g.updatedAt)) {
+      node.snapshot = {
+        status: g.status, goal: g.goal, turnsUsed: g.turnsUsed, maxTurns: g.maxTurns,
+        lastVerdict: typeof g.lastVerdict === "string" ? g.lastVerdict : null,
+        lastReason: typeof g.pausedReason === "string" ? g.pausedReason : typeof g.lastReason === "string" ? g.lastReason : null,
+      };
+      node.observedAt = g.updatedAt;
+      node.engineGoalId = g.id;
+    }
+    entries.set(entry.id, node);
+    leafId = entry.id;
+  }
+  const seen = new Set<string>();
+  let node = entries.get(explicitLeaf ?? leafId ?? "");
+  while (node && !seen.has(node.id)) {
+    if (node.snapshot) return node;
+    seen.add(node.id);
+    node = node.parentId ? entries.get(node.parentId) : undefined;
+  }
+  return null;
+}
+
+export function createGoalSnapshotSync(deps: {
+  store: GoalStore;
+  listSessions: () => Pick<DashboardSession, "id" | "cwd" | "goalId" | "sessionFile" | "status" | "originDeviceId">[];
+  onSnapshot?: (sessionId: string, snapshot: Snapshot) => void;
+  warn?: (message: string, error: unknown) => void;
+}) {
+  const seenFiles = new Map<string, string>();
+  let timer: ReturnType<typeof setInterval> | undefined;
+  let pending: Promise<void> | undefined;
+  let stopped = false;
+
+  async function scan(): Promise<void> {
+    const sessions = deps.listSessions().filter((s) => s.status !== "ended" && s.goalId);
+    const ids = new Set(sessions.map((s) => s.id));
+    for (const id of seenFiles.keys()) if (!ids.has(id)) seenFiles.delete(id);
+    for (const session of sessions) {
+      if (stopped) return;
+      const local = mayReadLocalSessionFile({ origin: originOf(session), sessionFile: session.sessionFile });
+      if (!local.allow) continue;
+      try {
+        const goals = await deps.store.list(session.cwd);
+        const goal = goals.find((g) => g.id === session.goalId && g.driverSessionId === session.id);
+        if (!goal) continue;
+        const stat = await fs.stat(local.sessionFile);
+        const signature = `${goal.id}:${local.sessionFile}:${stat.ino}:${stat.mtimeMs}:${stat.size}`;
+        if (seenFiles.get(session.id) === signature) continue;
+        const state = readSnapshot(await fs.readFile(local.sessionFile, "utf8"), session.id);
+        if (stopped) return;
+        if (!state?.snapshot) { seenFiles.set(session.id, signature); continue; }
+        const snapshot = state.snapshot;
+        // The primer collapses whitespace; the Hermes goal id is independent of GoalRecord.id.
+        if (snapshot.goal.replace(/\s+/g, " ").trim() !== goal.objective.replace(/\s+/g, " ").trim()) continue;
+        const live = deps.listSessions().find((s) => s.id === session.id);
+        if (!live || live.status === "ended" || live.originDeviceId || live.goalId !== goal.id || live.sessionFile !== local.sessionFile) continue;
+        const status = mapGoalStatus(snapshot.status)!;
+        const record = await deps.store.applyStatus(session.cwd, goal.id, {
+          status, lastKnownTurnsUsed: snapshot.turnsUsed, turnsDelta: 0, progressed: false,
+          sourceSessionId: session.id, observedAt: state.observedAt,
+          engineGoalId: state.engineGoalId,
+          statusReason: snapshot.lastReason ?? undefined,
+        });
+        if (stopped) return;
+        const cursor = record.liveGoalCursor;
+        if (record.driverSessionId === session.id && record.status === status && record.lastKnownTurnsUsed === snapshot.turnsUsed &&
+            cursor && cursor.observedAt === state.observedAt && cursor.engineGoalId === state.engineGoalId) {
+          deps.onSnapshot?.(session.id, snapshot);
+        }
+        seenFiles.set(session.id, signature);
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException)?.code !== "ENOENT") {
+          (deps.warn ?? console.warn)(`[goal-snapshot-sync] failed for ${session.id}`, error);
+        }
+      }
+    }
+  }
+
+  function poll(): Promise<void> {
+    if (stopped) return Promise.resolve();
+    if (!pending) pending = scan().finally(() => { pending = undefined; });
+    return pending;
+  }
+  function start(): void {
+    if (timer || stopped) return;
+    timer = setInterval(() => { void poll(); }, 2000);
+    timer.unref?.();
+    void poll();
+  }
+  async function stop(): Promise<void> {
+    stopped = true;
+    if (timer) clearInterval(timer);
+    await pending;
+    seenFiles.clear();
+  }
+  function handleLiveStatus(message: unknown, fallback: (message: unknown) => void): void {
+    const sessionId = (message as { sessionId?: string })?.sessionId;
+    const session = deps.listSessions().find((s) => s.id === sessionId);
+    if (session && mayReadLocalSessionFile({ origin: originOf(session), sessionFile: session.sessionFile }).allow) {
+      void poll();
+    } else {
+      fallback(message);
+    }
+  }
+  return { poll, start, stop, handleLiveStatus };
+}
