@@ -0,0 +1,448 @@
+import { describe, it, expect } from 'vitest';
+import { parseNativeNodes, flattenTasks, taskCounts, buildFlowGroups } from '../split/native-task-model.js';
+import { receiptMatchesTask } from '../split/native-receipts.js';
+describe('native task identity and bounds', () => {
+  it('keeps the step-owned projection of an identical nested run only once', () => {
+    const child={id:'nested',kind:'subagent',label:'critic',state:'complete',children:[{id:'step:0',kind:'step',state:'complete'}]};
+    const nodes=parseNativeNodes([{id:'root',kind:'subagent',children:[{id:'step:0',kind:'step',children:[child]},child]}]);
+    const rows=flattenTasks(nodes);
+    expect(rows.filter(row=>row.node.id==='nested')).toHaveLength(1);
+    expect(nodes[0].children[0].children[0].id).toBe('nested');
+  });
+  it('does not deduplicate conflicting states or same-name distinct runs', () => {
+    const child={id:'nested',kind:'subagent',label:'critic',state:'running'};
+    const nodes=parseNativeNodes([{id:'root',children:[{id:'step:0',kind:'step',children:[child]},{...child,state:'complete'},{...child,id:'other'}]}]);
+    expect(flattenTasks(nodes).filter(row=>row.node.kind==='subagent')).toHaveLength(3);
+  });
+  it('rejects oversized identities rather than truncating them into another task', () => {
+    expect(parseNativeNodes([{id:'x'.repeat(501)}])).toEqual([]);
+    expect(parseNativeNodes([{id:'exact/id'}])[0].id).toBe('exact/id');
+  });
+  it('preserves kind without confusing a workflow with the main agent', () => {
+    const nodes=parseNativeNodes([{id:'w',kind:'workflow',label:'critic, critic'},{id:'s',kind:'step',label:'检查布局'}]);
+    expect(nodes[0].label).toBe('工作流');
+    expect(nodes[1].kind).toBe('step');
+    expect(nodes[1].label).toBe('检查布局');
+  });
+  it('keeps parent-child identities and counts explicit states', () => {
+    const rows = flattenTasks(parseNativeNodes([{id:'a',state:'running',children:[{id:'b',state:'queued'}]}]));
+    expect(rows[1].parent).toBe(rows[0].key);
+    expect(taskCounts(rows)).toEqual({running:1,queued:1,complete:0,failed:0,other:0});
+  });
+  it('rejects invalid times and bounds broad recursive payloads', () => {
+    let children: unknown[] = [{id:'leaf',startedAt:Infinity}];
+    for(let i=0;i<8;i++) children = Array.from({length:40},()=>({id:'node',children}));
+    expect(flattenTasks(parseNativeNodes(children)).length).toBeLessThanOrEqual(200);
+    expect(parseNativeNodes([{id:'x',startedAt:NaN}])[0].startedAt).toBeUndefined();
+  });
+  it('never attributes siblings through nested IDs or text', () => {
+    expect(receiptMatchesTask({details:{runId:'a'}},'a')).toBe(true);
+    expect(receiptMatchesTask({details:{runId:'a',results:[{runId:'b'}]}},'b')).toBe(false);
+    expect(receiptMatchesTask({content:[{text:'runId: b'}]},'b')).toBe(false);
+  });
+  it('correctly determines hierarchy role and label', async () => {
+    const { hierarchyRole, hierarchyRoleLabel } = await import('../split/native-task-model.js');
+    expect(hierarchyRole({ id: 'w', label: 'W', state: 'complete', kind: 'workflow', children: [] }, 0)).toBe('workflow');
+    expect(hierarchyRoleLabel('workflow')).toBe('工作流');
+
+    expect(hierarchyRole({ id: 's', label: 'S', state: 'complete', kind: 'step', children: [] }, 1)).toBe('step');
+    expect(hierarchyRole({ id: 'hs', label: 'HS', state: 'complete', kind: 'host-step', children: [] }, 2)).toBe('step');
+    expect(hierarchyRoleLabel('step')).toBe('执行步骤');
+
+    expect(hierarchyRole({ id: 'c0', label: 'C0', state: 'running', kind: 'subagent', children: [] }, 0)).toBe('child');
+    expect(hierarchyRole({ id: 'c1', label: 'C1', state: 'running', kind: 'subagent', children: [] }, 1)).toBe('child');
+    expect(hierarchyRoleLabel('child')).toBe('子代理');
+
+    expect(hierarchyRole({ id: 'g2', label: 'G2', state: 'running', kind: 'subagent', children: [] }, 2)).toBe('grandchild');
+    expect(hierarchyRole({ id: 'g3', label: 'G3', state: 'running', kind: 'subagent', children: [] }, 3)).toBe('grandchild');
+    expect(hierarchyRoleLabel('grandchild')).toBe('孙代理');
+  });
+  it('identifies dispatcher of tasks along parent chain', async () => {
+    const { dispatcherOf } = await import('../split/native-task-model.js');
+    const nodes = parseNativeNodes([
+      {
+        id: 'parent-agent',
+        kind: 'subagent',
+        children: [
+          {
+            id: 'step-1',
+            kind: 'step',
+            children: [
+              {
+                id: 'child-agent',
+                kind: 'subagent',
+                children: []
+              }
+            ]
+          }
+        ]
+      }
+    ]);
+    const rows = flattenTasks(nodes);
+    const parentRow = rows.find(r => r.node.id === 'parent-agent')!;
+    const stepRow = rows.find(r => r.node.id === 'step-1')!;
+    const childRow = rows.find(r => r.node.id === 'child-agent')!;
+
+    // Root node has no dispatcher
+    expect(dispatcherOf(rows, parentRow)).toBeUndefined();
+    // Step has parent-agent as dispatcher
+    expect(dispatcherOf(rows, stepRow)?.node.id).toBe('parent-agent');
+    // Child agent under step traverses up to parent-agent
+    expect(dispatcherOf(rows, childRow)?.node.id).toBe('parent-agent');
+  });
+  it('groups child tasks and their parent in the same group with increasing depth', () => {
+    const nodes = parseNativeNodes([
+      {
+        id: 'parent-agent',
+        kind: 'subagent',
+        label: '规划者',
+        children: [
+          {
+            id: 'step-1',
+            kind: 'step',
+            label: '执行步骤 1',
+            children: [
+              {
+                id: 'child-agent',
+                kind: 'subagent',
+                label: '执行者',
+                children: []
+              }
+            ]
+          }
+        ]
+      }
+    ]);
+    const rows = flattenTasks(nodes);
+    const groups = buildFlowGroups(rows);
+
+    expect(groups.length).toBe(1);
+    const group = groups[0];
+    const parent = group.rows.find(r => r.node.id === 'parent-agent');
+    const step = group.rows.find(r => r.node.id === 'step-1');
+    const child = group.rows.find(r => r.node.id === 'child-agent');
+
+    // Assert: Child items and their parent are in the same group
+    expect(parent).toBeDefined();
+    expect(step).toBeDefined();
+    expect(child).toBeDefined();
+
+    // Assert: Depth increases along the ancestor chain
+    expect(parent!.depth).toBe(0);
+    expect(step!.depth).toBe(1);
+    expect(child!.depth).toBe(2);
+    expect(step!.depth).toBeGreaterThan(parent!.depth);
+    expect(child!.depth).toBeGreaterThan(step!.depth);
+  });
+  it('preserves fromPhase semantics when phase is specified on ancestor chain', () => {
+    const nodes = parseNativeNodes([
+      {
+        id: 'phase-parent',
+        kind: 'subagent',
+        phase: '分析阶段',
+        children: [
+          {
+            id: 'phase-child',
+            kind: 'step',
+            children: []
+          }
+        ]
+      }
+    ]);
+    const rows = flattenTasks(nodes);
+    const groups = buildFlowGroups(rows);
+
+    expect(groups.length).toBe(1);
+    expect(groups[0].fromPhase).toBe(true);
+    expect(groups[0].title).toContain('阶段 分析阶段');
+    expect(groups[0].rows).toHaveLength(2);
+    expect(groups[0].rows[0].depth).toBe(0);
