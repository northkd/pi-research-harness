+/** Offline integration checks against the real Pi extension loader and a local fake judge. */
+import assert from "node:assert/strict";
+import { existsSync } from "node:fs";
+import { createRequire } from "node:module";
+import path from "node:path";
+import { test } from "node:test";
+import { pathToFileURL } from "node:url";
+
+const source = process.env.PI_GOAL_HERMES_SOURCE;
+const sdk = process.env.PI_GOAL_TEST_SDK;
+if (!source || !sdk) throw new Error("Set PI_GOAL_HERMES_SOURCE and PI_GOAL_TEST_SDK to local package directories");
+const { createExtensionRuntime, loadExtensions } = await import(pathToFileURL(path.join(sdk, "dist/core/extensions/loader.js")));
+const { createEventBus } = await import(pathToFileURL(path.join(sdk, "dist/core/event-bus.js")));
+const requireSdk = createRequire(path.join(sdk, "package.json"));
+const aiEntry = requireSdk.resolve.paths("@earendil-works/pi-ai").map((dir) => path.join(dir, "@earendil-works/pi-ai/dist/compat.js")).find(existsSync);
+assert.ok(aiEntry, "Pi SDK compatibility API not found");
+const ai = await import(pathToFileURL(aiEntry));
+let networkCalls = 0;
+globalThis.fetch = async () => { networkCalls++; throw new Error("Network forbidden in offline Goal tests"); };
+const verdicts = [];
+const judgeCalls = [];
+const fakeStream = (_model, context) => {
+  judgeCalls.push(context);
+  const next = verdicts.shift();
+  assert.notEqual(next, undefined, "Unexpected judge invocation");
+  return { result: async () => ({ role: "assistant", content: [{ type: "text", text: typeof next === "function" ? await next() : next }], stopReason: "stop", usage: {} }) };
+};
+ai.registerApiProvider({ api: "local-goal-test", stream: fakeStream, streamSimple: fakeStream }, "goal-offline-test");
+
+function goal(over = {}) {
+  return { id: "test-only-engine-goal", goal: "Produce two evidence cards from the saved accepted inputs", status: "paused", turnsUsed: 1, maxTurns: 20,
+    lastVerdict: "continue", lastReason: null, pausedReason: "user pause", consecutiveParseFailures: 0,
+    subgoals: ["Keep completed work and all prior attempt limits"], createdAt: 100, updatedAt: 200, ...over };
+}
+const delay = () => new Promise((resolve) => setTimeout(resolve, 25));
+
+async function harness(initial = goal()) {
+  verdicts.length = 0; judgeCalls.length = 0;
+  const messages = [], writes = [], notices = [], acks = [];
+  const bus = createEventBus();
+  bus.on("dashboard:plugin-message", (message) => { if (message.messageType === "goal_budget_ack") acks.push(message.payload); });
+  const branch = initial ? [{ type: "custom", customType: "pi-goal-hermes:state", data: { goal: structuredClone(initial) } }] : [];
+  const runtime = createExtensionRuntime();
+  runtime.sendMessage = (message, options) => messages.push(structuredClone({ message, options }));
+  runtime.sendUserMessage = () => { throw new Error("Unexpected direct user turn"); };
+  runtime.appendEntry = (customType, data) => {
+    const entry = { type: "custom", customType, data: structuredClone(data) };
+    writes.push(entry); branch.push(entry);
+  };
+  const loaded = await loadExtensions([path.join(source, "index.ts")], source, bus, runtime);
+  assert.deepEqual(loaded.errors, []);
+  const extension = loaded.extensions[0];
+  const ctx = {
+    ui: { notify: (message, level) => notices.push({ message, level }), setStatus() {}, theme: { fg: (_color, value) => value } },
+    sessionManager: { getBranch: () => branch, getEntries: () => branch },
+    hasPendingMessages: () => false, isIdle: () => true, signal: new AbortController().signal,
+    model: { id: "test-only", api: "local-goal-test", provider: "local-test", name: "Offline test", input: ["text"], reasoning: false, contextWindow: 32000, maxTokens: 4096 },
+    modelRegistry: { getApiKeyAndHeaders: async () => ({ ok: true, apiKey: "offline", headers: {} }) },
+  };
+  const fire = async (name, event = {}) => { for (const handler of extension.handlers.get(name) ?? []) await handler({ type: name, ...event }, ctx); };
+  await fire("session_start", { reason: "new" });
+  const command = (text) => extension.commands.get("goal").handler(text, ctx);
+  const state = () => writes.at(-1)?.data.goal ?? branch[0]?.data.goal;
+  const continuations = () => messages.filter((x) => x.message.customType === "pi-goal-hermes:continuation" && x.options?.triggerTurn === true);
+  const end = async (text) => {
+    await fire("turn_end", { message: { role: "assistant", content: [{ type: "text", text }], stopReason: "stop" } });
+    await fire("agent_end"); await delay();
+  };
+  const subgoal = (text) => extension.commands.get("subgoal").handler(text, ctx);
+  const configure = (over = {}) => bus.emit("pi-goal-hermes:turn-budget", { requestId: "test-budget-request", objective: initial?.goal ?? "New objective", maxTurns: 30, engineGoalId: initial?.id, ...over });
+  return { ctx, command, subgoal, configure, acks, state, messages, writes, notices, continuations, end, fire };
+}
+
+test("explicit resume reopens done without replacing the engine goal, counters, criteria or budget", async () => {
+  const h = await harness(goal({ status: "done", lastVerdict: "done", lastReason: "previous blocker was misclassified" }));
+  await h.command("resume"); await delay();
+  assert.equal(h.state().status, "active");
+  assert.equal(h.state().id, "test-only-engine-goal");
+  assert.equal(h.state().turnsUsed, 1); assert.equal(h.state().maxTurns, 20); assert.equal(h.state().createdAt, 100);
+  assert.deepEqual(h.state().subgoals, ["Keep completed work and all prior attempt limits"]);
+  assert.equal(h.continuations().length, 1);
+});
+
+test("resume from paused preserves spent turns and an active duplicate queues nothing", async () => {
+  const h = await harness(goal({ turnsUsed: 7 }));
+  await h.command("resume"); await delay();
+  assert.equal(h.state().turnsUsed, 7);
+  await h.command("resume"); await delay();
+  assert.equal(h.continuations().length, 1);
+});
+
+test("spent loop budget cannot be reset by resume", async () => {
+  const h = await harness(goal({ turnsUsed: 20 }));
+  await h.command("resume"); await delay();
+  assert.equal(h.state().status, "paused"); assert.equal(h.state().turnsUsed, 20);
+  assert.equal(h.continuations().length, 0);
+});
+
+test("cleared or absent goals cannot be reopened accidentally", async () => {
+  for (const initial of [null, goal({ status: "cleared" })]) {
+    const h = await harness(initial); await h.command("resume"); await delay();
+    assert.equal(h.continuations().length, 0); assert.equal(h.writes.length, 0);
+  }
+});
+
+test("a persisted blocked verdict remains loadable and resumable", async () => {
+  const h = await harness(goal({ lastVerdict: "blocked", pausedReason: "missing input" }));
+  await h.command("resume"); await delay();
+  assert.equal(h.state().status, "active"); assert.equal(h.continuations().length, 1);
+});
+
+test("continuation uses current saved progress, prior authorization and original attempt limits", async () => {
+  const h = await harness(); await h.command("resume"); await delay();
