+/**
+ * Extract only finite numeric context-window overrides from models.json.
+ *
+ * This deliberately does not return or retain the override objects: credentials,
+ * headers, and every other metadata field stay outside the dashboard projection.
+ * Provider/model keys are stored in a Map so configuration keys such as
+ * `__proto__` cannot alter an ordinary object. Unknown models are harmless here;
+ * the registry applies the map only to models already present in its directory.
+ */
+export function readContextWindowOverrides(parsed: unknown): Map<string, number> {
+  const overrides = new Map<string, number>();
+  if (!isRecord(parsed) || !isRecord(parsed.providers)) return overrides;
+
+  for (const [provider, providerConfig] of Object.entries(parsed.providers)) {
+    if (!isRecord(providerConfig) || !isRecord(providerConfig.modelOverrides)) continue;
+    for (const [modelId, override] of Object.entries(providerConfig.modelOverrides)) {
+      if (modelId.length === 0 || !isRecord(override)) continue;
+      const contextWindow = override.contextWindow;
+      if (typeof contextWindow !== "number" || !Number.isFinite(contextWindow)) continue;
+      overrides.set(`${provider}/${modelId}`, contextWindow);
+    }
+  }
+
+  return overrides;
+}
