+/**
+ * Right pane switcher: a segmented control that toggles the right pane
+ * between the file editor and the Subagents view.
+ *
+ * Conforms to the WAI-ARIA APG radio-group pattern:
+ * `role="radiogroup"` with two `role="radio"` `aria-checked` segments, roving
+ * `tabindex`, Arrow/Home/End navigation, and Enter/Space selection.
+ */
+
+import { mdiFileDocumentOutline, mdiRobotOutline } from "@mdi/js";
+import { Icon } from "@mdi/react";
+import type React from "react";
+import { useRef } from "react";
+import type { RightPane } from "../../lib/layout/split-state.js";
+import { useOptionalSplitWorkspace } from "./SplitWorkspaceContext.js";
+
+interface Segment {
+  pane: RightPane;
+  icon: string;
+  label: string;
+}
+
+export function RightPaneSwitch() {
+  const ctx = useOptionalSplitWorkspace();
+  const refs = useRef<Array<HTMLButtonElement | null>>([]);
+  if (!ctx) return null;
+
+  const segments: Segment[] = [
+    { pane: "editor", icon: mdiFileDocumentOutline, label: "编辑器" },
+    { pane: "subagents", icon: mdiRobotOutline, label: "Subagents" },
+  ];
+  const active = ctx.split.rightPane;
+  const activeIndex = segments.findIndex((s) => s.pane === active);
+
+  const focusSegment = (index: number) => {
+    const clamped = (index + segments.length) % segments.length;
+    ctx.setRightPane(segments[clamped].pane);
+    refs.current[clamped]?.focus();
+  };
+
+  const onKeyDown = (e: React.KeyboardEvent, index: number) => {
+    switch (e.key) {
+      case "ArrowRight":
+      case "ArrowDown":
+        e.preventDefault();
+        focusSegment(index + 1);
+        break;
+      case "ArrowLeft":
+      case "ArrowUp":
+        e.preventDefault();
+        focusSegment(index - 1);
+        break;
+      case "Home":
+        e.preventDefault();
+        focusSegment(0);
+        break;
+      case "End":
+        e.preventDefault();
+        focusSegment(segments.length - 1);
+        break;
+      case " ":
+      case "Enter":
+        e.preventDefault();
+        ctx.setRightPane(segments[index].pane);
+        break;
+    }
+  };
+
+  return (
+    <div
+      role="radiogroup"
+      aria-label="右窗格视图"
+      data-testid="right-pane-switch"
+      className="inline-flex shrink-0 items-center whitespace-nowrap rounded border border-[var(--border-secondary)] overflow-hidden"
+    >
+      {segments.map((seg, i) => {
+        const checked = seg.pane === active;
+        return (
+          <button
+            key={seg.pane}
+            ref={(el) => {
+              refs.current[i] = el;
+            }}
+            type="button"
+            role="radio"
+            aria-checked={checked}
+            aria-label={seg.label}
+            tabIndex={i === (activeIndex < 0 ? 0 : activeIndex) ? 0 : -1}
+            data-testid={`right-pane-${seg.pane}`}
+            onClick={() => ctx.setRightPane(seg.pane)}
+            onKeyDown={(e) => onKeyDown(e, i)}
+            title={seg.label}
+            className={`inline-flex shrink-0 items-center gap-0.5 text-[10px] px-1.5 py-0.5 transition-colors ${
+              checked
+                ? "text-blue-400 bg-blue-500/10"
+                : "text-[var(--text-tertiary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)]"
+            }`}
+          >
+            <Icon path={seg.icon} size={0.4} className="inline" />
+            {seg.label}
+          </button>
+        );
+      })}
+    </div>
+  );
+}
