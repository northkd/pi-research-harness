+import {usePluginSend,useSessionEvents} from '@blackbelt-technology/dashboard-plugin-runtime/context';
+import {useEffect,useState} from 'react';
+/** Explicit on-demand fetch; no background transcript polling. */
+export function NativeTaskDetail({sessionId,address}:{sessionId:string;address?:string}) {
+ const send=usePluginSend();const events=useSessionEvents(sessionId);
+ const [request,setRequest]=useState<{id:string;address:string}>();
+ const [error,setError]=useState('');
+ const current=request?.address===address?request:undefined;
+ const response=current?[...events].reverse().find(e=>e.eventType==='native_subagent_detail'&&e.data.requestId===current.id&&e.data.address===address)?.data:undefined;
+ const text=response?.ok===true?String(response.text??''):'';
+ const facts={agent:/Agent:\s*([^\n\r]+)/.exec(text)?.[1],state:/State:\s*([^\n\r]+)/.exec(text)?.[1],mode:/Mode:\s*([^\n\r]+)/.exec(text)?.[1]};
+ const workSummary=text.split(/\n|\r/).find(line=>/^Step:\s*\d+/.test(line))?.replace(/^Step:\s*\d+\s*\((.*?)\)/,'$1');
+ useEffect(()=>{
+  if(!current || response)return;
+  const timer=setTimeout(()=>setError('未收到回复，请确认详情适配器已启用后重试'),20000);
+  return ()=>clearTimeout(timer);
+ },[current?.id,response]);
+ const load=()=>{
+  if(!address)return;
+  const id=crypto.randomUUID();setRequest({id,address});setError('');
+  Promise.resolve(send({type:'subagent_resync_request',sessionId,agentId:address,requestId:id,reason:'open'})).catch(()=>setError('请求发送失败'));
+ };
+ return <section className="space-y-2 border-t border-[var(--border-secondary)] pt-3" aria-label="执行器记录">
+  <div className="flex items-center justify-between gap-2"><h4 className="text-xs font-medium">执行器记录</h4><button type="button" disabled={!address || (!!current && !response && !error)} onClick={load} className="rounded border border-[var(--border-secondary)] px-2 py-1 text-xs disabled:opacity-50 focus-visible:outline">{current?'重新加载':'加载记录'}</button></div>
