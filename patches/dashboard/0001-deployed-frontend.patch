+import { useSessionEvents } from '@blackbelt-technology/dashboard-plugin-runtime/context';
+import { nativeReceipts } from './native-receipts.js';
+
+const focus = 'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--text-secondary)]';
+
+/** Existing parent-session receipts only; no invented child transcript or filesystem reads. */
+export function NativeExecutionRecords({sessionId, taskId}: {sessionId: string; taskId?: string}) {
+  const events = useSessionEvents(sessionId);
+  const records = nativeReceipts(events, taskId);
+  return <details className="min-w-0 rounded-lg border border-[var(--border-secondary)] px-3">
+    <summary className={`cursor-pointer rounded py-2.5 text-[13px] font-medium ${focus}`}>{taskId ? '任务回执' : '执行回执'} <span className="ml-1 text-[11px] font-normal tabular-nums text-[var(--text-secondary)]">{records.length}</span></summary>
+    <p className="mb-2 text-[11px] leading-relaxed text-[var(--text-secondary)]">工具回执片段 · 启动回执不等于任务完成 · 最多 30 条</p>
+    {!records.length && <p className="pb-3 text-xs text-[var(--text-secondary)]" title="仅显示可明确归属的记录">暂无回执。</p>}
+    {records.map((event, index) => {
+      const content = JSON.stringify(event.data.result ?? event.data, null, 2) ?? '';
+      return <details key={`${String(event.data.toolCallId)}:${index}`} className="min-w-0 border-t border-[var(--border-secondary)]">
+        <summary className={`cursor-pointer rounded py-1.5 text-xs hover:bg-[var(--bg-secondary)] ${focus}`}>
+          <span className="inline-flex max-w-[calc(100%-20px)] items-center gap-2 align-middle">
+            <time className="shrink-0 text-[11px] tabular-nums text-[var(--text-secondary)]">{new Date(event.timestamp).toLocaleTimeString()}</time>
+            <span className={`shrink-0 rounded border border-[var(--border-secondary)] px-1.5 text-[11px] ${event.data.isError ? 'border-l-2 border-l-red-500' : ''}`}>{event.data.isError ? '工具错误' : '工具回执'}</span>
+            <span className="min-w-0 truncate font-mono text-[11px] text-[var(--text-secondary)]" title={String(event.data.toolCallId ?? index)}>{String(event.data.toolCallId ?? index)}</span>
+          </span>
+        </summary>
+        <pre tabIndex={0} aria-label="回执内容" className={`my-2 max-h-64 overflow-auto whitespace-pre-wrap break-all rounded bg-[var(--bg-secondary)] p-3 font-mono text-[11px] leading-relaxed ${focus}`}>{content.slice(0, 32000)}{content.length > 32000 ? '\n[展示已截断]' : ''}</pre>
+      </details>;
+    })}
+  </details>;
+}
