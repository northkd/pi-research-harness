+import { useSessionEvents } from '@blackbelt-technology/dashboard-plugin-runtime/context';
+import { useEffect, useMemo, useState } from 'react';
+import { NativeExecutionRecords } from './NativeExecutionRecords.js';
+import { NativeTaskDetail } from './NativeTaskDetail.js';
+import {
+  buildFlowGroups,
+  dispatcherOf,
+  flattenTasks,
+  hierarchyRole,
+  hierarchyRoleLabel,
+  modelShortName,
+  nodeKindLabel,
+  parseNativeNodes,
+  progressSegments,
+  type HierarchyRole,
+  type TaskRow,
+} from './native-task-model.js';
+
+export { parseNativeNodes } from './native-task-model.js';
+
+const labels: Record<string, string> = {
+  running: '运行中',
+  queued: '排队',
+  complete: '已完成',
+  failed: '失败',
+  paused: '暂停',
+  stopped: '已停止',
+  partial: '部分完成',
+  rejected: '已拒绝',
+  unknown: '未知',
+};
+
+const focus = 'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--text-secondary)]';
+
+const dot = (state: string) =>
+  state === 'running'
+    ? 'bg-blue-500'
+    : state === 'queued'
+    ? 'bg-amber-500'
+    : state === 'complete'
+    ? 'bg-emerald-500'
+    : state === 'failed'
+    ? 'bg-red-500'
+    : 'bg-[var(--text-secondary)]';
+
+const ring = (state: string) =>
+  state === 'running'
+    ? 'border-blue-500/60'
+    : state === 'failed'
+    ? 'border-red-500/70'
+    : state === 'complete'
+    ? 'border-emerald-500/50'
+    : 'border-[var(--border-secondary)]';
+
+const edgeColor = (state: string) =>
+  state === 'failed'
+    ? 'stroke-red-500/70'
+    : state === 'complete'
+    ? 'stroke-emerald-500/60'
+    : state === 'running'
+    ? 'stroke-blue-500/70'
+    : 'stroke-[var(--border-secondary)]';
+
+function StatusBadge({state}: {state: string}) {
+  return (
+    <span
+      className="inline-flex min-w-0 max-w-full items-center gap-1.5 rounded-full border border-[var(--border-secondary)] bg-[var(--bg-secondary)] px-2 py-0.5 text-[11px] font-medium"
+      title={labels[state] || state}
+    >
+      <span
+        aria-hidden="true"
+        className={`h-1.5 w-1.5 shrink-0 rounded-full ${dot(state)} ${
+          state === 'running' ? 'motion-safe:animate-pulse motion-reduce:animate-none' : ''
+        }`}
+      />
+      <span className="truncate">{labels[state] || state}</span>
+    </span>
+  );
+}
+
+function RoleBadge({role}: {role: HierarchyRole}) {
+  const label = hierarchyRoleLabel(role);
+  const color =
+    role === 'child'
