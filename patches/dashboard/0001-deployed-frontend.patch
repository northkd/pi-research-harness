+import type { DashboardEvent } from '@blackbelt-technology/pi-dashboard-shared/types.js';
+/** Exact root identity only. Nested identity does not authorize showing siblings' output. */
+export function receiptMatchesTask(value: unknown, taskId: string): boolean {
+  if (!taskId || !value || typeof value !== 'object') return false;
+  const details = (value as Record<string, unknown>).details;
+  if (!details || typeof details !== 'object') return false;
+  const record = details as Record<string, unknown>;
+  return ['runId','asyncId','id'].some(key => typeof record[key] === 'string' && record[key] === taskId);
+}
+export function nativeReceipts(events: readonly DashboardEvent[], taskId?: string): DashboardEvent[] {
+  const calls = new Set<string>();
+  for (const event of events) {
+    if (event.eventType === 'tool_execution_start' && event.data.toolName === 'subagent' && typeof event.data.toolCallId === 'string') calls.add(event.data.toolCallId);
+  }
+  return events.filter(event => event.eventType === 'tool_execution_end'
+    && (event.data.toolName === 'subagent' || calls.has(String(event.data.toolCallId)))
+    && (!taskId || receiptMatchesTask(event.data.result, taskId))).slice(-30);
+}
