+  const items = use.length ? use : rows;
+  const byKey = new Map(rows.map(r => [r.key, r]));
+
+  function rootAncestorOf(row: TaskRow): TaskRow {
+    let current = row;
+    const seen = new Set<string>();
+    while (current.parent && !seen.has(current.parent)) {
+      seen.add(current.parent);
+      const parentRow = byKey.get(current.parent);
+      if (!parentRow) break;
+      current = parentRow;
+    }
+    return current;
+  }
+
+  function rootPhaseOf(root: TaskRow): string | undefined {
+    if (root.node.phase?.trim()) return root.node.phase.trim();
+    let currentKey = root.parent;
+    const seen = new Set<string>();
+    while (currentKey && !seen.has(currentKey)) {
+      seen.add(currentKey);
+      const parentRow = byKey.get(currentKey);
+      if (!parentRow) break;
+      if (parentRow.node.phase?.trim()) return parentRow.node.phase.trim();
+      currentKey = parentRow.parent;
+    }
+    return undefined;
+  }
+
+  function compareSiblings(left: TaskRow, right: TaskRow): number {
+    const lo = left.node.order, ro = right.node.order;
+    if (lo !== undefined && ro !== undefined && lo !== ro) return lo - ro;
+    if (lo !== undefined && ro === undefined) return -1;
+    if (lo === undefined && ro !== undefined) return 1;
+    return stateRank(left.node.state) - stateRank(right.node.state);
+  }
