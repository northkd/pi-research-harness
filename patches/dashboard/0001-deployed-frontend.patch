+  const groups = new Map<string, FlowGroup>();
+  items.forEach((row) => {
+    const root = rootAncestorOf(row);
+    const disp = dispatcherOf(rows, root);
+    const dispName = disp ? (disp.node.label || disp.node.id) : '主 Agent';
+    const phase = rootPhaseOf(root);
+    const title = phase ? `由 ${dispName} 派发 · 阶段 ${phase}` : `由 ${dispName} 派发`;
+    const dispKey = disp ? disp.key : '__main__';
+    const groupKey = `${dispKey}\u0000${phase ?? ''}`;
+    const existing = groups.get(groupKey);
