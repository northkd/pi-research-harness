+export interface TaskNode {
+  id: string; label: string; state: string; description?: string; kind?: string;
+  startedAt?: number; endedAt?: number; modelThinking?: string; model?: string;
+  /** Child session title ("<agent>: <task excerpt>"), same mechanism as a main session. */
+  sessionName?: string;
+  /** Execution-order index from the snapshot. Order, NOT a dependency edge. */
+  order?: number;
+  /** Optional workflow phase grouping name. */
+  phase?: string;
+  tokens?: { input?: number; output?: number; cacheRead?: number; cacheWrite?: number; total?: number };
+  cost?: { inputTokens?: number; outputTokens?: number; usd?: number };
+  activity?: { currentTool?: string; turnCount?: number; toolCount?: number };
+  children: TaskNode[];
+}
+const text = (value: unknown) => typeof value === 'string' ? value.slice(0, 500) : '';
+const time = (value: unknown) => typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : undefined;
+const count = (value: unknown) => typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : undefined;
+/** Global node budget, not exponential per-level allocation. */
+export function parseNativeNodes(value: unknown): TaskNode[] {
+  let remaining = 200;
+  function walk(input: unknown, depth: number): TaskNode[] {
+    if (!Array.isArray(input) || depth > 5) return [];
+    const out: TaskNode[] = [];
+    for (const item of input.slice(0, 40)) {
+      if (!remaining) break;
+      if (!item || typeof item !== 'object' || typeof item.id !== 'string' || !item.id || item.id.length > 500) continue;
+      remaining--;
+      out.push({ id: item.id, kind: text(item.kind), label: item.kind === 'workflow' ? '工作流' : text(item.label), state: text(item.state) || 'unknown',
+        description: text(item.description) || text(item.goal) || undefined,
+        startedAt: time(item.startedAt), endedAt: time(item.endedAt), modelThinking: text(item.modelThinking),
+        model: text(item.model) || undefined,
+        order: count(item.order), phase: text(item.phase) || undefined,
+        sessionName: text(item.sessionName) || undefined,
+        tokens: item.tokens && typeof item.tokens === 'object' ? {
+          input: count(item.tokens.input), output: count(item.tokens.output),
+          cacheRead: count(item.tokens.cacheRead), cacheWrite: count(item.tokens.cacheWrite),
+          total: count(item.tokens.total)
+        } : undefined,
+        cost: item.cost && typeof item.cost === 'object' ? {
+          inputTokens: count(item.cost.inputTokens),
+          outputTokens: count(item.cost.outputTokens),
+          usd: typeof item.cost.usd === 'number' && Number.isFinite(item.cost.usd) ? item.cost.usd : undefined
+        } : undefined,
+        activity: {
+          currentTool: text(item.activity?.currentTool),
+          turnCount: count(item.activity?.turnCount),
+          toolCount: count(item.activity?.toolCount)
+        }, children: walk(item.children, depth + 1) });
+    }
+    // The producer may project a nested run both under its owning step and
+    // directly under that step's parent run. Only collapse identical copies;
+    // conflicting snapshots stay visible rather than discarding evidence.
+    const stepRuns = new Map<string, TaskNode[]>();
+    for (const step of out.filter(node => node.kind === 'step')) {
+      for (const child of step.children) {
+        if (child.kind !== 'subagent' && child.kind !== 'workflow') continue;
+        const key = `${child.kind}:${child.id}`;
+        stepRuns.set(key, [...(stepRuns.get(key) ?? []), child]);
+      }
+    }
+    return out.filter(node => {
+      if (node.kind !== 'subagent' && node.kind !== 'workflow') return true;
+      const matches = stepRuns.get(`${node.kind}:${node.id}`);
+      return !(matches?.length === 1 && JSON.stringify(matches[0]) === JSON.stringify(node));
+    });
+  }
+  return walk(value, 0);
+}
+export function nodeKindLabel(kind?: string): string {
+  return kind === 'workflow' ? '工作流' : kind === 'subagent' ? '子代理运行' : kind === 'step' ? '执行步骤' : kind === 'host-step' ? '宿主步骤' : '节点';
+}
+/** Short display form of a `provider/id` model ref; full ref belongs in a title. */
+export function modelShortName(model?: string): string | undefined {
+  if (!model) return undefined;
+  const id = model.split('/').pop() ?? model;
+  return id.length > 22 ? `${id.slice(0, 21)}…` : id;
+}
+export interface TaskRow { key: string; parent?: string; depth: number; node: TaskNode }
+export function flattenTasks(nodes: TaskNode[]): TaskRow[] {
+  const out: TaskRow[] = [];
+  function walk(items: TaskNode[], parent: string | undefined, depth: number) {
+    items.forEach((node, index) => {
+      const key = `${parent ?? 'root'}/${index}:${node.id}`;
+      out.push({key, parent, depth, node}); walk(node.children, key, depth + 1);
+    });
+  }
+  walk(nodes, undefined, 0); return out;
+}
+export function taskCounts(rows: TaskRow[]) {
+  const result = {running: 0, queued: 0, complete: 0, failed: 0, other: 0};
+  for (const {node} of rows) {
+    if (node.state === 'running') result.running++;
+    else if (node.state === 'queued') result.queued++;
+    else if (node.state === 'complete') result.complete++;
+    else if (node.state === 'failed') result.failed++;
+    else result.other++;
+  }
+  return result;
+}
+const STATE_RANK: Record<string, number> = { running: 0, queued: 1, failed: 2, partial: 3, paused: 4, stopped: 5, rejected: 6, complete: 7, unknown: 8 };
+export function stateRank(state: string): number {
+  return STATE_RANK[state] ?? 9;
+}
+export interface ProgressSegment { key: string; label: string; count: number; className: string }
+/** Container (workflow) rows are grouping labels, not executables, so they are
+ * excluded from the completion ratio. */
+export function progressSegments(rows: TaskRow[]): { segments: ProgressSegment[]; total: number; done: number; percent: number } {
+  const countable = rows.filter(row => row.node.kind !== 'workflow');
+  const use = countable.length ? countable : rows;
+  const counts = taskCounts(use);
+  const segments: ProgressSegment[] = [
+    { key: 'complete', label: '已完成', count: counts.complete, className: 'bg-emerald-500' },
+    { key: 'running', label: '运行中', count: counts.running, className: 'bg-blue-500' },
+    { key: 'failed', label: '失败', count: counts.failed, className: 'bg-red-500' },
+    { key: 'queued', label: '排队', count: counts.queued, className: 'bg-amber-500' },
+    { key: 'other', label: '其他', count: counts.other, className: 'bg-[var(--text-secondary)]' },
+  ];
+  const total = use.length;
+  const done = counts.complete;
+  return { segments, total, done, percent: total ? Math.round((done / total) * 100) : 0 };
+}
+export type HierarchyRole = 'main' | 'child' | 'grandchild' | 'step' | 'workflow';
+
+export function hierarchyRole(node: TaskNode, depth: number): HierarchyRole {
+  if (node.kind === 'workflow') return 'workflow';
+  if (node.kind === 'step' || node.kind === 'host-step') return 'step';
+  if (node.kind === 'main') return 'main';
+  if (depth <= 1) return 'child';
+  return 'grandchild';
+}
+
+export function hierarchyRoleLabel(role: HierarchyRole): string {
+  switch (role) {
+    case 'main':
+      return '主代理';
+    case 'child':
+      return '子代理';
+    case 'grandchild':
+      return '孙代理';
+    case 'step':
+      return '执行步骤';
+    case 'workflow':
+      return '工作流';
+  }
+}
+
+/**
+ * Returns the nearest ancestor in the parent chain that is a subagent or workflow.
+ * Root nodes (no ancestor) return undefined.
+ */
+export function dispatcherOf(rows: TaskRow[], row: TaskRow): TaskRow | undefined {
+  const byKey = new Map(rows.map(r => [r.key, r]));
+  let currentKey = row.parent;
+  const seen = new Set<string>();
+  while (currentKey && !seen.has(currentKey)) {
+    seen.add(currentKey);
+    const parentRow = byKey.get(currentKey);
+    if (!parentRow) break;
+    if (parentRow.node.kind === 'subagent' || parentRow.node.kind === 'workflow') {
+      return parentRow;
+    }
+    currentKey = parentRow.parent;
+  }
+  return undefined;
+}
+
+export interface FlowGroup { key: string; title: string; rows: TaskRow[]; fromPhase: boolean }
+/** Build the execution-order spine for the flow view.
+ *
+ * IMPORTANT: pi-subagents does not record dependency edges (there is no
+ * `dependsOn` field anywhere in its status/snapshot schema). The only real
+ * ordering facts available are `order` and `phase`. The flow view therefore
+ * draws execution ORDER, never a dependency graph, and the UI must say so. */
+export function buildFlowGroups(rows: TaskRow[]): FlowGroup[] {
