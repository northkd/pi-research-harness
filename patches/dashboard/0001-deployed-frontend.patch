+
+function depthBorderColor(node: {kind?: string}, depth: number): string {
+  if (node.kind === 'step' || node.kind === 'host-step') {
+    return 'border-l-2 border-l-[var(--border-secondary)]';
+  }
+  if (node.kind === 'workflow') {
+    return 'border-l-2 border-l-amber-500';
+  }
+  if (depth <= 1) {
+    return 'border-l-2 border-l-blue-500';
+  }
+  if (depth === 2) {
+    return 'border-l-2 border-l-purple-500';
+  }
+  return 'border-l-2 border-l-cyan-500';
