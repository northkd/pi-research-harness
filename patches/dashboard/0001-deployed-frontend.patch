+
+function isDuplicateStep(row: TaskRow, allRows: TaskRow[], now?: number): boolean {
+  if (row.node.kind !== 'step') return false;
+  if (!row.parent) return false;
+  const parentRow = allRows.find(r => r.key === row.parent);
+  if (!parentRow || parentRow.node.kind !== 'subagent') return false;
+
+  const rowLabel = row.node.label || row.node.id;
+  const parentLabel = parentRow.node.label || parentRow.node.id;
+  if (rowLabel !== parentLabel) return false;
+
+  const rowDesc = (row.node.description || '').trim();
+  const parentDesc = (parentRow.node.description || '').trim();
+  if (rowDesc !== parentDesc) return false;
+
+  const getDur = (n: typeof row.node) =>
+    n.startedAt !== undefined
+      ? Math.max(0, Math.round(((n.endedAt ?? now ?? Date.now()) - n.startedAt) / 1000))
+      : undefined;
+  const rowDur = getDur(row.node);
+  const parentDur = getDur(parentRow.node);
+  return rowDur === parentDur;
+}
+
+function getAncestorAtDepth(
+  row: TaskRow,
+  depth: number,
+  byKey: Map<string, TaskRow>,
+): TaskRow | undefined {
+  let curr: TaskRow | undefined = row;
+  while (curr) {
+    if (curr.depth === depth) return curr;
+    curr = curr.parent ? byKey.get(curr.parent) : undefined;
+  }
+  return undefined;
+}
+
+function isDescendantOf(
+  candidate: TaskRow,
+  ancestorKey: string,
+  byKey: Map<string, TaskRow>,
+): boolean {
+  let curr: TaskRow | undefined = candidate;
+  const seen = new Set<string>();
+  while (curr?.parent && !seen.has(curr.parent)) {
+    seen.add(curr.parent);
+    if (curr.parent === ancestorKey) return true;
+    curr = byKey.get(curr.parent);
+  }
+  return false;
+}
