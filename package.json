{
  "name": "pi-research-harness",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Portable Pi research environment, evidence workflows and deployed dashboard customizations",
  "repository": {
    "type": "git",
    "url": "https://github.com/northkd/pi-research-harness.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./integration/index.mjs",
      "./extensions/undo-last.ts",
      "./extensions/mainline-supervision/src/index.ts"
    ],
    "skills": [
      "./integration/skills",
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test integration/test/*.test.mjs tests/*.test.mjs && npm run test:supervision",
    "test:supervision": "node extensions/mainline-supervision/scripts/run-checks.mjs offline",
    "test:supervision:host": "node extensions/mainline-supervision/scripts/run-checks.mjs host",
    "test:supervision:sdk": "node extensions/mainline-supervision/scripts/run-checks.mjs sdk",
    "test:dashboard:layout": "node scripts/test-dashboard-layout.mjs .runtime/dashboard-source --css-overlay",
    "check:release": "python3 scripts/check-release.py",
    "check:syntax": "bash scripts/check-syntax.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
